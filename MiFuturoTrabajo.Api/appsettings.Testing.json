{
  "Persistence": {
    "Provider": "InMemory"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },

  // Test-only values. Deterministic on purpose so the integration suite is
  // self-contained and does not depend on user-secrets or a gitignored
  // appsettings.json. This key never protects anything real.
  "Jwt": {
    "SecretKey": "integration-tests-only-not-a-real-secret-0123456789abcdef",
    "Issuer": "MiFuturoTrabajo",
    "Audience": "MiFuturoTrabajo.Client",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },

  // TestWebApplicationFactory swaps in the InMemory provider, so no
  // Cosmos connection string is needed here.
  "CosmosDb": {
    "ConnectionString": "",
    "DatabaseName": "MiFuturoTrabajoTests"
  },

  "AzureCommunicationServices": {
    "ConnectionString": "",
    "SenderAddress": "tests@example.invalid"
  },

  "AzureStorage": {
    "ConnectionString": "UseDevelopmentStorage=true"
  },

  // The whole suite shares one rate-limit partition - there is no real client
  // address behind a TestServer - so production ceilings would have tests
  // failing each other rather than testing anything. RateLimiterTests sets its
  // own tiny limit to prove the limiter actually works.
  "RateLimits": {
    "AuthPermitPerMinute": 100000,
    "PerUserPermitPerMinute": 100000
  },

  "BlazorClient": {
    "Url": "http://localhost"
  },

  // Generous on purpose: a test that creates 30 companies is exercising a
  // controller, not abusing the service. QuotaEnforcementTests sets its own
  // tiny limits to prove the caps actually bite.
  "Quotas": {
    "JobApplications": 100000,
    "Companies": 100000,
    "Recruiters": 100000,
    "Meetings": 100000,
    "Tasks": 100000,
    "CVVersions": 100000
  },

  // Test-only identifiers. Real ones are not needed: the suite never talks to
  // Google or Entra, it exercises how this API treats what they return.
  "OAuth": {
    "Google": {
      "ClientId": "tests-only.apps.googleusercontent.com"
    },
    "Microsoft": {
      "ClientId": "11111111-2222-3333-4444-555555555555",
      "TenantId": "common"
    }
  }
}
