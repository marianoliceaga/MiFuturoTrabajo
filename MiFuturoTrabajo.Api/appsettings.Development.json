  //   AccountUrl       - managed identity via DefaultAzureCredential. No key in
  //                      configuration, and downloads use user-delegation SAS.
  //                      This is what a deployed environment sets.
  //   ConnectionString - shared key. Locally that means Azurite:
  //                        npx azurite
  //
  "AzureStorage": {
    "AccountUrl": "",
    "ConnectionString": "UseDevelopmentStorage=true"
