@using Microsoft.AspNetCore.Components.Authorization
@using Letmework4U.Client.Services
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject Blazored.Toast.Services.IToastService ToastService

<AuthorizeView>
    <Authorized>
        <div class="user-info-container">
            <div class="user-details">
                <i class="bi bi-person-circle" style="font-size: 24px;"></i>
                <div class="user-text">
                    <!--<strong>@GetUserName(context)</strong>-->
                    <small>@GetUserEmail(context)</small>
                </div>
            </div>
            <button class="btn-logout" @onclick="HandleLogout" title="Logout">
                <i class="bi bi-box-arrow-right"></i>
            </button>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="user-info-container">
            <a href="/login" class="btn btn-primary btn-sm">Login</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string GetUserName(AuthenticationState context)
    {
        var claims = context.User.Claims.ToList();

        // Try to get name from claims
        var givenName = claims.FirstOrDefault(c => c.Type == "Name")?.Value;
        var familyName = claims.FirstOrDefault(c => c.Type == "Lastname")?.Value;

        if (!string.IsNullOrEmpty(givenName) && !string.IsNullOrEmpty(familyName))
        {
            return $"{givenName} {familyName}";
        }

        return context.User.Identity?.Name ?? "User";
    }

    private string GetUserEmail(AuthenticationState context)
    {
        var claims = context.User.Claims.ToList();
        return claims.FirstOrDefault(c => c.Type == "email" || c.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")?.Value ?? "";
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        ToastService.ShowInfo("Logged out successfully");
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}

<style>
    .user-info-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .user-details {
        display: flex;
        align-items: center;
        gap: 12px;
        flex: 1;
    }

    .user-text {
        display: flex;
        flex-direction: column;
    }

    .user-text strong {
        display: block;
        font-size: 14px;
    }

    .user-text small {
        display: block;
        font-size: 12px;
        color: rgba(255,255,255,0.6);
    }

    .btn-logout {
        background: rgba(255,255,255,0.1);
        border: none;
        color: white;
        padding: 8px 12px;
        border-radius: 4px;
        cursor: pointer;
        transition: background 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-logout:hover {
        background: rgba(255,255,255,0.2);
    }

    .btn-logout i {
        font-size: 18px;
    }
</style>
