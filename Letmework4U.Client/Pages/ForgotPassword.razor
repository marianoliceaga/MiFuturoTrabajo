@page "/forgot-password"
@inject IAuthenticationService AuthService
@inject Blazored.Toast.Services.IToastService ToastService

<PageTitle>Forgot Password - Letmework4U</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h2 class="card-title text-center mb-4">Forgot Password</h2>

                    @if (emailSent)
                    {
                        <div class="alert alert-success" role="alert">
                            <h5 class="alert-heading">Check your email!</h5>
                            <p>If an account exists with that email, we've sent password reset instructions.</p>
                            <hr />
                            <p class="mb-0">Didn't receive it? Check your spam folder or <a href="#" @onclick="() => emailSent = false" @onclick:preventDefault>try again</a>.</p>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-4">Enter your email address and we'll send you instructions to reset your password.</p>

                        <EditForm Model="@email" OnValidSubmit="@HandleForgotPassword">
                            <div class="mb-3">
                                <label for="email" class="form-label">Email</label>
                                <input id="email" type="email" class="form-control" @bind="email" placeholder="your@email.com" required />
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>Sending...</span>
                                    }
                                    else
                                    {
                                        <span>Send Reset Link</span>
                                    }
                                </button>
                            </div>
                        </EditForm>

                        <hr class="my-4" />

                        <div class="text-center">
                            <p class="mb-0">
                                <a href="/login" class="text-decoration-none">Back to Login</a>
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = string.Empty;
    private bool emailSent = false;
    private bool isLoading = false;

    private async Task HandleForgotPassword()
    {
        isLoading = true;

        try
        {
            var result = await AuthService.ForgotPasswordAsync(email);

            // Always show success to prevent email enumeration
            emailSent = true;

            if (result)
            {
                ToastService.ShowInfo("Password reset instructions sent");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Forgot password error: {ex.Message}");
            emailSent = true; // Still show success to user
        }
        finally
        {
            isLoading = false;
        }
    }
}
