@page "/applications"
@using Letmework4U.Shared.Models
@using Letmework4U.Client.Services
@inject IJobApplicationService JobApplicationService
@inject NavigationManager NavigationManager

<div class="applications-container">
    <div class="page-header">
        <div class="header-left">
            <h2><i class="bi bi-briefcase"></i> Job Applications</h2>
            <p class="text-muted">Manage all your job applications</p>
        </div>
        <div class="header-actions">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" class="form-control" placeholder="Search applications..." 
                       @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleSearch" />
            </div>
            <div class="filter-group">
                <select class="form-select" @bind="statusFilter" @bind:after="FilterApplications">
                    <option value="">All Statuses</option>
                    @foreach (JobApplicationStatus status in Enum.GetValues(typeof(JobApplicationStatus)))
                    {
                        <option value="@status">@status</option>
                    }
                </select>
                <select class="form-select" @bind="sourceFilter" @bind:after="FilterApplications">
                    <option value="">All Sources</option>
                    @foreach (JobSource source in Enum.GetValues(typeof(JobSource)))
                    {
                        <option value="@source">@source</option>
                    }
                </select>
            </div>
            <button class="btn btn-primary" @onclick="CreateNew">
                <i class="bi bi-plus-lg"></i> New Application
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p>Loading applications...</p>
        </div>
    }
    else if (!filteredApplications.Any())
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <h4>No applications found</h4>
            <p>@(string.IsNullOrEmpty(searchTerm) ? "Start by creating your first job application" : "Try adjusting your search or filters")</p>
            @if (string.IsNullOrEmpty(searchTerm))
            {
                <button class="btn btn-primary" @onclick="CreateNew">
                    <i class="bi bi-plus-lg"></i> Create First Application
                </button>
            }
        </div>
    }
    else
    {
        <div class="stats-bar">
            <div class="stat-card">
                <div class="stat-icon bg-primary"><i class="bi bi-briefcase"></i></div>
                <div class="stat-content">
                    <h3>@applications.Count</h3>
                    <p>Total Applications</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon bg-info"><i class="bi bi-send"></i></div>
                <div class="stat-content">
                    <h3>@applications.Count(a => a.Status == JobApplicationStatus.Applied)</h3>
                    <p>Applied</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon bg-warning"><i class="bi bi-hourglass-split"></i></div>
                <div class="stat-content">
                    <h3>@applications.Count(a => a.Status == JobApplicationStatus.FirstInterview || a.Status == JobApplicationStatus.Meetings)</h3>
                    <p>In Process</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon bg-success"><i class="bi bi-check-circle"></i></div>
                <div class="stat-content">
                    <h3>@applications.Count(a => a.Status == JobApplicationStatus.Offer)</h3>
                    <p>Offers</p>
                </div>
            </div>
        </div>

        <div class="view-controls">
            <div class="view-toggle">
                <button class="btn btn-sm @(viewMode == "list" ? "btn-primary" : "btn-outline-secondary")"
                        @onclick='() => viewMode = "list"'>
                    <i class="bi bi-list-ul"></i> List
                </button>
                <button class="btn btn-sm @(viewMode == "grid" ? "btn-primary" : "btn-outline-secondary")"
                        @onclick='() => viewMode = "grid"'>
                    <i class="bi bi-grid-3x3"></i> Grid
                </button>
            </div>
            <div class="sort-controls">
                <select class="form-select form-select-sm" @bind="sortBy" @bind:after="SortApplications">
                    <option value="dateApplied">Date Applied</option>
                    <option value="company">Company</option>
                    <option value="jobTitle">Job Title</option>
                    <option value="status">Status</option>
                    <option value="deadline">Deadline</option>
                </select>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleSortOrder">
                    <i class="bi bi-sort-@(sortAscending ? "down" : "up")"></i>
                </button>
            </div>
            <span class="results-count">Showing @filteredApplications.Count of @applications.Count</span>
        </div>

        @if (viewMode == "list")
        {
            <div class="applications-table">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Company</th>
                            <th>Job Title</th>
                            <th>Location</th>
                            <th>Source</th>
                            <th>Status</th>
                            <th>Date Applied</th>
                            <th>Deadline</th>
                            <th>Salary</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in filteredApplications)
                        {
                            <tr class="application-row" @onclick="() => ViewDetails(app.Id)">
                                <td>
                                    <div class="company-cell">
                                        <strong>@app.Company?.Name</strong>
                                        @if (app.IsConsultancy)
                                        {
                                            <span class="badge bg-secondary">Consultancy</span>
                                        }
                                        else if (app.IsDirect)
                                        {
                                            <span class="badge bg-primary">Direct</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="job-title-cell">
                                        @app.JobTitle
                                        @if (app.InterviewSteps.Any())
                                        {
                                            <small class="text-muted d-block">
                                                <i class="bi bi-diagram-3"></i> @app.InterviewSteps.Count step(s)
                                            </small>
                                        }
                                    </div>
                                </td>
                                <td><i class="bi bi-geo-alt text-muted"></i> @app.Location</td>
                                <td><span class="badge bg-info">@app.Source</span></td>
                                <td><span class="badge status-@app.Status.ToString().ToLower()">@app.Status</span></td>
                                <td>@app.DateApplied.ToShortDateString()</td>
                                <td>
                                    @if (app.DeadLine != default)
                                    {
                                        var daysUntil = (app.DeadLine - DateTime.Now).Days;
                                        <span class="@(daysUntil < 0 ? "text-danger" : daysUntil < 7 ? "text-warning" : "")">
                                            @app.DeadLine.ToShortDateString()
                                            @if (daysUntil >= 0)
                                            {
                                                <small class="d-block">(@daysUntil days)</small>
                                            }
                                            else
                                            {
                                                <small class="d-block">(Overdue)</small>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (app.Salary > 0)
                                    {
                                        <strong>$@app.Salary.ToString("N0")</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="action-buttons" @onclick:stopPropagation="true">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EditApplication(app.Id)" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteApplication(app.Id)" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="applications-grid">
                @foreach (var app in filteredApplications)
                {
                    <div class="application-card" @onclick="() => ViewDetails(app.Id)">
                        <div class="card-header">
                            <div class="card-title">
                                <h5>@app.JobTitle</h5>
                                <span class="badge status-@app.Status.ToString().ToLower()">@app.Status</span>
                            </div>
                            <div class="card-actions" @onclick:stopPropagation="true">
                                <button class="btn btn-sm btn-link" @onclick="() => EditApplication(app.Id)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="company-info">
                                <i class="bi bi-building"></i>
                                <strong>@app.Company?.Name</strong>
                            </div>
                            <div class="info-row">
                                <span><i class="bi bi-geo-alt"></i> @app.Location</span>
                                <span><i class="bi bi-calendar"></i> @app.DateApplied.ToShortDateString()</span>
                            </div>
                            @if (app.Salary > 0)
                            {
                                <div class="salary-info">
                                    <i class="bi bi-currency-dollar"></i>
                                    <strong>$@app.Salary.ToString("N0")</strong>
                                </div>
                            }
                            <div class="tags">
                                <span class="badge bg-info">@app.Source</span>
                                @if (app.IsDirect)
                                {
                                    <span class="badge bg-primary">Direct</span>
                                }
                                @if (app.InterviewSteps.Any())
                                {
                                    <span class="badge bg-warning">@app.InterviewSteps.Count interview(s)</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private List<JobApplicationDto> applications = new();
    private List<JobApplicationDto> filteredApplications = new();
    private bool isLoading = true;
    private string searchTerm = "";
    private string statusFilter = "";
    private string sourceFilter = "";
    private string sortBy = "dateApplied";
    private bool sortAscending = false;
    private string viewMode = "list";

    protected override async Task OnInitializedAsync()
    {
        await LoadApplications();
    }

    private async Task LoadApplications()
    {
        isLoading = true;
        try
        {
            applications = await JobApplicationService.GetAllAsync();
            FilterApplications();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading applications: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterApplications()
    {
        filteredApplications = applications.AsEnumerable().ToList();

        if (!string.IsNullOrEmpty(searchTerm))
        {
            filteredApplications = filteredApplications.Where(a =>
                (a.JobTitle?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.Company?.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.Location?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
            ).ToList();
        }

        if (!string.IsNullOrEmpty(statusFilter) && Enum.TryParse<JobApplicationStatus>(statusFilter, out var status))
        {
            filteredApplications = filteredApplications.Where(a => a.Status == status).ToList();
        }

        if (!string.IsNullOrEmpty(sourceFilter) && Enum.TryParse<JobSource>(sourceFilter, out var source))
        {
            filteredApplications = filteredApplications.Where(a => a.Source == source).ToList();
        }

        SortApplications();
    }

    private void SortApplications()
    {
        filteredApplications = sortBy switch
        {
            "company" => sortAscending 
                ? filteredApplications.OrderBy(a => a.Company?.Name).ToList()
                : filteredApplications.OrderByDescending(a => a.Company?.Name).ToList(),
            "jobTitle" => sortAscending
                ? filteredApplications.OrderBy(a => a.JobTitle).ToList()
                : filteredApplications.OrderByDescending(a => a.JobTitle).ToList(),
            "status" => sortAscending
                ? filteredApplications.OrderBy(a => a.Status).ToList()
                : filteredApplications.OrderByDescending(a => a.Status).ToList(),
            "deadline" => sortAscending
                ? filteredApplications.OrderBy(a => a.DeadLine).ToList()
                : filteredApplications.OrderByDescending(a => a.DeadLine).ToList(),
            _ => sortAscending
                ? filteredApplications.OrderBy(a => a.DateApplied).ToList()
                : filteredApplications.OrderByDescending(a => a.DateApplied).ToList()
        };
    }

    private void ToggleSortOrder()
    {
        sortAscending = !sortAscending;
        SortApplications();
    }

    private void HandleSearch()
    {
        FilterApplications();
    }

    private void ViewDetails(string id)
    {
        NavigationManager.NavigateTo($"/applications/{id}");
    }

    private void EditApplication(string id)
    {
        NavigationManager.NavigateTo($"/applications/{id}");
    }

    private async Task DeleteApplication(string id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this application?"))
        {
            try
            {
                await JobApplicationService.DeleteAsync(id);
                await LoadApplications();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting application: {ex.Message}");
            }
        }
    }

    private void CreateNew()
    {
        NavigationManager.NavigateTo("/applications/new");
    }

    [Inject] private IJSRuntime JSRuntime { get; set; }
}

