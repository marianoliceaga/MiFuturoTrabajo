@page "/login-callback"
@inject NavigationManager Navigation

<PageTitle>Login Callback - Letmework4U</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Processing login...</span>
            </div>
            <p class="mt-3">Processing your login...</p>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        // This page is used as a redirect URI for OAuth providers
        // The actual authentication happens in the Login page via JavaScript
        // Redirect back to login if user lands here directly
        Navigation.NavigateTo("/login");
    }
}
