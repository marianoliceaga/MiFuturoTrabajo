@using MiFuturoTrabajo.Shared.Models
@using MiFuturoTrabajo.Client.Services
@inject ICompanyService CompanyService

@if (IsVisible)
{
    <div class="modal show" style="display: block; background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(IsEditMode ? L["Companies_EditTitle"] : L["Companies_AddTitle"])</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> @errorMessage
                            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label">@L["Companies_NameLabel"]</label>
                        <input type="text" class="form-control" @bind="currentCompany.Name" placeholder="@L["Companies_NamePlaceholder"]" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["Common_Description"]</label>
                        <textarea class="form-control" rows="3" @bind="currentCompany.Description" placeholder="@L["Companies_DescriptionPlaceholder"]"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@L["Common_Website"]</label>
                            <input type="url" class="form-control" @bind="currentCompany.Website" placeholder="https://..." />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@L["Common_Telephone"]</label>
                            <input type="tel" class="form-control" @bind="currentCompany.Telephone" placeholder="@L["Companies_TelephonePlaceholder"]" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label class="form-label">@L["Common_Address"]</label>
                            <input type="text" class="form-control" @bind="currentCompany.Address" placeholder="@L["Companies_AddressPlaceholder"]" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">@L["Common_Country"]</label>
                            <input type="text" class="form-control" @bind="currentCompany.Country" placeholder="@L["Common_Country"]" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["Companies_LabelsLabel"]</label>
                        <input type="text" class="form-control" @bind="labelsInput" placeholder="@L["Companies_LabelsPlaceholder"]" />
                        <small class="form-text text-muted">@L["Companies_LabelsHint"]</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Close">@L["Common_Cancel"]</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveCompany" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        @(IsEditMode ? L["Companies_UpdateAction"] : L["Companies_AddAction"])
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public CompanyDto Company { get; set; } = default!;

    [Parameter]
    public EventCallback<CompanyDto> OnCompanySaved { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public string InitialName { get; set; } = string.Empty;

    private bool IsEditMode => Company != null && !string.IsNullOrEmpty(Company.Id);
    private CompanyDto currentCompany = new();
    private string labelsInput = "";
    private bool isSaving = false;
    private string errorMessage = "";
    private bool wasVisible = false;

    protected override void OnParametersSet()
    {
        // Only reinitialize when the modal becomes visible (transition from hidden to visible)
        if (IsVisible && !wasVisible)
        {
            errorMessage = ""; // Clear any previous errors

            if (Company != null && !string.IsNullOrEmpty(Company.Id))
            {
                // Edit mode - copy the company data
                currentCompany = new CompanyDto
                {
                    Id = Company.Id,
                    Name = Company.Name,
                    Description = Company.Description ?? "",
                    Website = Company.Website ?? "",
                    Telephone = Company.Telephone ?? "",
                    Address = Company.Address ?? "",
                    Country = Company.Country ?? "",
                    Labels = new List<string>(Company.Labels ?? new List<string>())
                };
                labelsInput = string.Join(", ", Company.Labels ?? new List<string>());
            }
            else
            {
                // Add mode - new company
                currentCompany = new CompanyDto
                {
                    Id = Guid.NewGuid().ToString(),
                    Name = InitialName ?? "",
                    Description = "",
                    Website = "",
                    Telephone = "",
                    Address = "",
                    Country = "",
                    Labels = new List<string>()
                };
                labelsInput = "";
            }
        }

        wasVisible = IsVisible;
    }

    private async Task SaveCompany()
    {
        errorMessage = ""; // Clear previous errors

        if (string.IsNullOrWhiteSpace(currentCompany.Name))
        {
            errorMessage = L["Companies_NameRequired"];
            return;
        }

        // Parse labels from comma-separated input
        currentCompany.Labels = labelsInput
            .Split(',')
            .Select(l => l.Trim())
            .Where(l => !string.IsNullOrWhiteSpace(l))
            .ToList();

        isSaving = true;
        StateHasChanged(); // Force UI update

        try
        {
            CompanyDto savedCompany;
            if (IsEditMode)
            {
                Console.WriteLine($"Updating company: {currentCompany.Name} (ID: {currentCompany.Id})");
                savedCompany = await CompanyService.UpdateAsync(currentCompany.Id, currentCompany);
                Console.WriteLine($"Company updated successfully");
            }
            else
            {
                Console.WriteLine($"Creating new company: {currentCompany.Name}");
                savedCompany = await CompanyService.CreateAsync(currentCompany);
                Console.WriteLine($"Company created successfully with ID: {savedCompany?.Id}");
            }

            if (savedCompany != null)
            {
                await OnCompanySaved.InvokeAsync(savedCompany);
                Close(); // Close the modal and reset state
            }
            else
            {
                errorMessage = L["Companies_SaveFailedRetry"];
            }
        }
        catch (HttpRequestException httpEx)
        {
            errorMessage = L["Common_NetworkError", httpEx.Message];
            Console.WriteLine($"HTTP Error saving company: {httpEx.Message}");
            Console.WriteLine($"Stack trace: {httpEx.StackTrace}");
        }
        catch (Exception ex)
        {
            errorMessage = L["Companies_SaveError", ex.Message];
            Console.WriteLine($"Error saving company: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged(); // Force UI update
        }
    }

    private void Close()
    {
        currentCompany = new();
        labelsInput = "";
        OnCancel.InvokeAsync();
    }
}
