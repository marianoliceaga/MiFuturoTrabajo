@using Microsoft.AspNetCore.Components.Authorization
@using MiFuturoTrabajo.Client.Services
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject Blazored.Toast.Services.IToastService ToastService

<AuthorizeView>
    <Authorized>
        <div class="user-info-container">
            <div class="user-details">
                <i class="bi bi-person-circle" style="font-size: 24px;"></i>
                <div class="user-text">
                    <small>@GetUserEmail(context)</small>
                </div>
            </div>
            <button class="btn-logout" @onclick="HandleLogout" title="@L["Auth_Logout"]" aria-label="@L["Auth_Logout"]">
                <i class="bi bi-box-arrow-right"></i>
            </button>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="user-info-container">
            <a href="/login" class="btn btn-primary btn-sm">@L["Auth_Login"]</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string GetUserEmail(AuthenticationState context)
    {
        var claims = context.User.Claims.ToList();
        return claims.FirstOrDefault(c => c.Type == "email" || c.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")?.Value ?? "";
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        ToastService.ShowInfo(L["Auth_LoggedOut"]);
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
