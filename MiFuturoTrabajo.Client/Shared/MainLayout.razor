@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject ICultureService Culture
@inject IUserPreferenceService Preferences
@inject AuthenticationStateProvider AuthStateProvider

<div class="app-container">
    <nav class="sidebar">
        <div class="sidebar-header">
            <h3>@L["App_Name"]</h3>
            <p class="tagline">@L["App_Tagline"]</p>
        </div>

        <div class="nav-menu">
            <NavLink class="nav-item" href="/board" Match="NavLinkMatch.All">
                <i class="bi bi-kanban"></i>
                <span>@L["Nav_Board"]</span>
            </NavLink>

            <NavLink class="nav-item" href="/calendar">
                <i class="bi bi-calendar"></i>
                <span>@L["Nav_Calendar"]</span>
            </NavLink>

            <NavLink class="nav-item" href="/applications">
                <i class="bi bi-briefcase"></i>
                <span>@L["Nav_Applications"]</span>
            </NavLink>

            <NavLink class="nav-item" href="/tasks">
                <i class="bi bi-check-square"></i>
                <span>@L["Nav_Tasks"]</span>
            </NavLink>

            <NavLink class="nav-item" href="/meetings">
                <i class="bi bi-camera-video"></i>
                <span>@L["Nav_Meetings"]</span>
            </NavLink>

            <NavLink class="nav-item" href="/companies">
                <i class="bi bi-building"></i>
                <span>@L["Nav_Companies"]</span>
            </NavLink>

            <NavLink class="nav-item" href="/recruiters">
                <i class="bi bi-people"></i>
                <span>@L["Nav_Recruiters"]</span>
            </NavLink>

            <div class="nav-divider"></div>

            <NavLink class="nav-item" href="/profile">
                <i class="bi bi-person-circle"></i>
                <span>@L["Nav_MyProfile"]</span>
            </NavLink>

            <NavLink class="nav-item" href="/settings">
                <i class="bi bi-gear"></i>
                <span>@L["Nav_Settings"]</span>
            </NavLink>
        </div>

        <div class="sidebar-footer">
            <LoginDisplay />
        </div>
    </nav>

    <main class="main-content">
        <div class="topbar">
            <div class="topbar-left">
                <button class="btn-menu" @onclick="ToggleSidebar" aria-label="@L["Nav_Menu"]">
                    <i class="bi bi-list"></i>
                </button>
                <div class="breadcrumb">
                    @GetCurrentPageTitle()
                </div>
            </div>
            <div class="topbar-right">
                <LanguageSelector />
                <ThemeToggle />
                <button class="btn btn-icon" title="@L["Topbar_Notifications"]">
                    <i class="bi bi-bell"></i>
                    <span class="badge">3</span>
                </button>
                <button class="btn btn-icon" title="@L["Topbar_Help"]">
                    <i class="bi bi-question-circle"></i>
                </button>
            </div>
        </div>

        <div class="page-content">
            @Body
        </div>
    </main>
</div>

@code {
    private bool sidebarCollapsed = false;

    /// <summary>
    /// Mirrors the browser's language onto the signed-in account, once per app
    /// load.
    ///
    /// Without this, someone whose language was detected from their browser and
    /// who never touched the switcher would have an account still marked with
    /// the default - and would get their reminder emails in a language they do
    /// not read, while the UI in front of them is correct. The switcher pushes
    /// on change; this covers the far more common case of never changing it.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated == true)
        {
            await Preferences.TrySaveLanguageAsync(Culture.CurrentCode);
        }
    }

    private void ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
    }

    private string GetCurrentPageTitle()
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return path.Split('/')[0] switch
        {
            "" or "board" => L["PageTitle_Board"],
            "calendar" => L["Nav_Calendar"],
            "applications" => L["Nav_Applications"],
            "tasks" => L["Nav_Tasks"],
            "meetings" => L["Nav_Meetings"],
            "companies" => L["Nav_Companies"],
            "recruiters" => L["Nav_Recruiters"],
            "cv-versions" => L["Nav_CvVersions"],
            "profile" => L["Nav_MyProfile"],
            "settings" => L["Nav_Settings"],
            _ => L["PageTitle_Fallback"]
        };
    }
}
