@page "/login"
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject Blazored.Toast.Services.IToastService ToastService
@inject IJSRuntime JSRuntime
@using MiFuturoTrabajo.Shared.Models
@implements IDisposable

<PageTitle>Login - MiFuturoTrabajo</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h2 class="card-title text-center mb-4">Welcome Back</h2>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @errorMessage
                        </div>
                    }

                    <EditForm Model="@loginRequest" OnValidSubmit="@HandleLogin">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <InputText id="email" class="form-control" @bind-Value="loginRequest.Email" placeholder="your@email.com" />
                            <ValidationMessage For="@(() => loginRequest.Email)" />
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">Password</label>
                            <InputText id="password" type="password" class="form-control" @bind-Value="loginRequest.Password" placeholder="Enter your password" />
                            <ValidationMessage For="@(() => loginRequest.Password)" />
                        </div>

                        <div class="mb-3 form-check">
                            <InputCheckbox id="rememberMe" class="form-check-input" @bind-Value="loginRequest.RememberMe" />
                            <label class="form-check-label" for="rememberMe">
                                Remember me
                            </label>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Logging in...</span>
                                }
                                else
                                {
                                    <span>Login</span>
                                }
                            </button>
                        </div>
                    </EditForm>

                    <hr class="my-4" />

                    <div class="text-center mb-3">
                        <p class="text-muted">Or sign in with</p>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <!-- Google Sign-In Button -->
                        <button type="button" class="btn btn-outline-danger" @onclick="HandleGoogleLogin" disabled="@isOAuthLoading">
                            @if (isOAuthLoading && currentProvider == "Google")
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-google me-2" viewBox="0 0 16 16">
                                <path d="M15.545 6.558a9.42 9.42 0 0 1 .139 1.626c0 2.434-.87 4.492-2.384 5.885h.002C11.978 15.292 10.158 16 8 16A8 8 0 1 1 8 0a7.689 7.689 0 0 1 5.352 2.082l-2.284 2.284A4.347 4.347 0 0 0 8 3.166c-2.087 0-3.86 1.408-4.492 3.304a4.792 4.792 0 0 0 0 3.063h.003c.635 1.893 2.405 3.301 4.492 3.301 1.078 0 2.004-.276 2.722-.764h-.003a3.702 3.702 0 0 0 1.599-2.431H8v-3.08h7.545z"/>
                            </svg>
                            Sign in with Google
                        </button>

                        <!-- Microsoft Sign-In Button -->
                        <button type="button" class="btn btn-outline-primary" @onclick="HandleMicrosoftLogin" disabled="@isOAuthLoading">
                            @if (isOAuthLoading && currentProvider == "Microsoft")
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-microsoft me-2" viewBox="0 0 16 16">
                                <path d="M7.462 0H0v7.19h7.462V0zM16 0H8.538v7.19H16V0zM7.462 8.211H0V16h7.462V8.211zm8.538 0H8.538V16H16V8.211z"/>
                            </svg>
                            Sign in with Microsoft
                        </button>
                    </div>

                    <hr class="my-4" />

                    <div class="text-center">
                        <p class="mb-2">
                            <a href="/forgot-password" class="text-decoration-none">Forgot password?</a>
                        </p>
                        <p class="mb-0">
                            Don't have an account? <a href="/register" class="text-decoration-none fw-bold">Sign up</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginRequest loginRequest = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool isOAuthLoading = false;
    private string currentProvider = string.Empty;
    private DotNetObjectReference<Login>? objRef;

    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            // Set up the global callback for Google Sign-In
            await JSRuntime.InvokeVoidAsync("setGoogleCallback", objRef);
        }
    }

    private async Task HandleLogin()
    {
        errorMessage = string.Empty;
        isLoading = true;

        try
        {
            var result = await AuthService.LoginAsync(loginRequest);

            if (result != null)
            {
                ToastService.ShowSuccess("Login successful!");

                // Redirect to return URL or default to home
                var redirectUrl = !string.IsNullOrEmpty(ReturnUrl) ? ReturnUrl : "/";
                Navigation.NavigateTo(redirectUrl, forceLoad: true);
            }
            else
            {
                errorMessage = "Invalid email or password. Please try again.";
                ToastService.ShowError("Login failed");
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred during login. Please try again.";
            Console.WriteLine($"Login error: {ex.Message}");
            ToastService.ShowError("Login error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleGoogleLogin()
    {
        try
        {
            isOAuthLoading = true;
            currentProvider = "Google";
            errorMessage = string.Empty;

            // Trigger Google One Tap
            await JSRuntime.InvokeVoidAsync("showGoogleOneTap");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to initiate Google login. Please try again.";
            Console.WriteLine($"Google login error: {ex.Message}");
            ToastService.ShowError("Google login failed");
            isOAuthLoading = false;
        }
    }

    [JSInvokable]
    public async Task HandleGoogleCredential(string credential)
    {
        try
        {
            var oauthRequest = new OAuthLoginRequest
            {
                Provider = OAuthProvider.Google,
                IdToken = credential
            };

            await ProcessOAuthLogin(oauthRequest, "Google");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to process Google login. Please try again.";
            Console.WriteLine($"Google credential processing error: {ex.Message}");
            ToastService.ShowError("Google login failed");
            isOAuthLoading = false;
        }
    }

    private async Task HandleMicrosoftLogin()
    {
        try
        {
            isOAuthLoading = true;
            currentProvider = "Microsoft";
            errorMessage = string.Empty;

            // Call the JavaScript function to login with Microsoft
            var idToken = await JSRuntime.InvokeAsync<string>("loginWithMicrosoft");

            var oauthRequest = new OAuthLoginRequest
            {
                Provider = OAuthProvider.Microsoft,
                IdToken = idToken
            };

            await ProcessOAuthLogin(oauthRequest, "Microsoft");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to login with Microsoft. Please try again.";
            Console.WriteLine($"Microsoft login error: {ex.Message}");
            ToastService.ShowError("Microsoft login failed");
            isOAuthLoading = false;
        }
    }

    private async Task ProcessOAuthLogin(OAuthLoginRequest request, string providerName)
    {
        try
        {
            var result = await AuthService.OAuthLoginAsync(request);

            if (result != null)
            {
                ToastService.ShowSuccess($"Logged in successfully with {providerName}!");

                // Redirect to return URL or default to home
                var redirectUrl = !string.IsNullOrEmpty(ReturnUrl) ? ReturnUrl : "/";
                Navigation.NavigateTo(redirectUrl, forceLoad: true);
            }
            else
            {
                errorMessage = $"{providerName} login failed. Please try again.";
                ToastService.ShowError($"{providerName} login failed");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred during {providerName} login. Please try again.";
            Console.WriteLine($"{providerName} login error: {ex.Message}");
            ToastService.ShowError($"{providerName} login error");
        }
        finally
        {
            isOAuthLoading = false;
            currentProvider = string.Empty;
        }
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }
}
