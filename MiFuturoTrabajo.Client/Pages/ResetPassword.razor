@page "/reset-password"
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject Blazored.Toast.Services.IToastService ToastService

<PageTitle>@L["Reset_PageTitle"]</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h2 class="card-title text-center mb-4">@L["Reset_Heading"]</h2>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @errorMessage
                        </div>
                    }

                    @if (resetSuccessful)
                    {
                        <div class="alert alert-success" role="alert">
                            <h5 class="alert-heading">@L["Reset_SuccessHeading"]</h5>
                            <p>@L["Reset_SuccessBody"]</p>
                            <hr />
                            <p class="mb-0">@L["Reset_SuccessCanLoginBefore"] <a href="/login">@L["Auth_Login"]</a> @L["Reset_SuccessCanLoginAfter"]</p>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="@resetRequest" OnValidSubmit="@HandleResetPassword">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label for="email" class="form-label">@L["Common_Email"]</label>
                                <InputText id="email" type="email" class="form-control" @bind-Value="resetRequest.Email" placeholder="@L["Common_EmailPlaceholder"]" />
                                <ValidationMessage For="@(() => resetRequest.Email)" />
                            </div>

                            <div class="mb-3">
                                <label for="newPassword" class="form-label">@L["Reset_NewPassword"]</label>
                                <InputText id="newPassword" type="password" class="form-control" @bind-Value="resetRequest.NewPassword" placeholder="@L["Register_PasswordPlaceholder"]" />
                                <ValidationMessage For="@(() => resetRequest.NewPassword)" />
                            </div>

                            <div class="mb-3">
                                <label for="confirmPassword" class="form-label">@L["Register_ConfirmPassword"]</label>
                                <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="resetRequest.ConfirmPassword" placeholder="@L["Register_ConfirmPasswordPlaceholder"]" />
                                <ValidationMessage For="@(() => resetRequest.ConfirmPassword)" />
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>@L["Reset_InProgress"]</span>
                                    }
                                    else
                                    {
                                        <span>@L["Reset_Heading"]</span>
                                    }
                                </button>
                            </div>
                        </EditForm>

                        <hr class="my-4" />

                        <div class="text-center">
                            <p class="mb-0">
                                <a href="/login" class="text-decoration-none">@L["Auth_BackToLogin"]</a>
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ResetPasswordRequest resetRequest = new();
    private string errorMessage = string.Empty;
    private bool resetSuccessful = false;
    private bool isLoading = false;

    [Parameter]
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    /// <summary>
    /// Prefilled from the link so the person resetting does not have to retype
    /// the address, and so the API can do a single-partition lookup.
    /// </summary>
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Email))
        {
            resetRequest.Email = Email;
        }

        if (!string.IsNullOrEmpty(Token))
        {
            resetRequest.ResetToken = Token;
        }
    }

    private async Task HandleResetPassword()
    {
        errorMessage = string.Empty;
        isLoading = true;

        try
        {
            // Validate passwords match
            if (resetRequest.NewPassword != resetRequest.ConfirmPassword)
            {
                errorMessage = L["Register_PasswordMismatch"];
                isLoading = false;
                return;
            }

            // Validate password length
            if (resetRequest.NewPassword.Length < 8)
            {
                errorMessage = L["Register_PasswordTooShort"];
                isLoading = false;
                return;
            }

            var result = await AuthService.ResetPasswordAsync(resetRequest);

            if (result)
            {
                resetSuccessful = true;
                ToastService.ShowSuccess(L["Reset_Success"]);
            }
            else
            {
                errorMessage = L["Reset_Failed"];
                ToastService.ShowError(L["Reset_FailedShort"]);
            }
        }
        catch (Exception ex)
        {
            errorMessage = L["Reset_UnexpectedError"];
            Console.WriteLine($"Reset password error: {ex.Message}");
            ToastService.ShowError(L["Reset_FailedShort"]);
        }
        finally
        {
            isLoading = false;
        }
    }
}
