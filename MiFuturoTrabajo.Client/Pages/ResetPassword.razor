@page "/reset-password"
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject Blazored.Toast.Services.IToastService ToastService

<PageTitle>Reset Password - MiFuturoTrabajo</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h2 class="card-title text-center mb-4">Reset Password</h2>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @errorMessage
                        </div>
                    }

                    @if (resetSuccessful)
                    {
                        <div class="alert alert-success" role="alert">
                            <h5 class="alert-heading">Password Reset Successful!</h5>
                            <p>Your password has been reset successfully.</p>
                            <hr />
                            <p class="mb-0">You can now <a href="/login">login</a> with your new password.</p>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="@resetRequest" OnValidSubmit="@HandleResetPassword">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label for="email" class="form-label">Email</label>
                                <InputText id="email" type="email" class="form-control" @bind-Value="resetRequest.Email" placeholder="your@email.com" />
                                <ValidationMessage For="@(() => resetRequest.Email)" />
                            </div>

                            <div class="mb-3">
                                <label for="newPassword" class="form-label">New Password</label>
                                <InputText id="newPassword" type="password" class="form-control" @bind-Value="resetRequest.NewPassword" placeholder="At least 8 characters" />
                                <ValidationMessage For="@(() => resetRequest.NewPassword)" />
                            </div>

                            <div class="mb-3">
                                <label for="confirmPassword" class="form-label">Confirm Password</label>
                                <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="resetRequest.ConfirmPassword" placeholder="Re-enter your password" />
                                <ValidationMessage For="@(() => resetRequest.ConfirmPassword)" />
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>Resetting password...</span>
                                    }
                                    else
                                    {
                                        <span>Reset Password</span>
                                    }
                                </button>
                            </div>
                        </EditForm>

                        <hr class="my-4" />

                        <div class="text-center">
                            <p class="mb-0">
                                <a href="/login" class="text-decoration-none">Back to Login</a>
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ResetPasswordRequest resetRequest = new();
    private string errorMessage = string.Empty;
    private bool resetSuccessful = false;
    private bool isLoading = false;

    [Parameter]
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Token))
        {
            resetRequest.ResetToken = Token;
        }
    }

    private async Task HandleResetPassword()
    {
        errorMessage = string.Empty;
        isLoading = true;

        try
        {
            // Validate passwords match
            if (resetRequest.NewPassword != resetRequest.ConfirmPassword)
            {
                errorMessage = "Passwords do not match.";
                isLoading = false;
                return;
            }

            // Validate password length
            if (resetRequest.NewPassword.Length < 8)
            {
                errorMessage = "Password must be at least 8 characters long.";
                isLoading = false;
                return;
            }

            var result = await AuthService.ResetPasswordAsync(resetRequest);

            if (result)
            {
                resetSuccessful = true;
                ToastService.ShowSuccess("Password reset successfully!");
            }
            else
            {
                errorMessage = "Failed to reset password. The reset link may be invalid or expired.";
                ToastService.ShowError("Password reset failed");
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while resetting your password. Please try again.";
            Console.WriteLine($"Reset password error: {ex.Message}");
            ToastService.ShowError("Reset password error");
        }
        finally
        {
            isLoading = false;
        }
    }
}
