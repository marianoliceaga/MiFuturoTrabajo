@page "/cv-versions"
@using MiFuturoTrabajo.Shared.Models
@using MiFuturoTrabajo.Client.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using Blazored.Toast.Services
@attribute [Authorize]
@inject ICVVersionService CVVersionService
@inject IApplicantService ApplicantService
@inject IJSRuntime JSRuntime
@inject IToastService ToastService

<div class="cv-container">
    <div class="cv-header">
        <h2>@L["Cv_Heading"]</h2>
        <button class="btn btn-primary" @onclick="ShowAddCVModal">
            <i class="bi bi-plus"></i> @L["Cv_Add"]
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading">@L["Common_Loading"]</div>
    }
    else if (cvVersions.Any())
    {
        <div class="cv-list">
            @foreach (var cv in cvVersions)
            {
                <div class="cv-card @(cv.IsDefault ? "default-cv" : "")">
                    <div class="cv-main">
                        <div class="cv-info">
                            <div class="cv-title">
                                <h5>@cv.Name</h5>
                                @if (cv.IsDefault)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-star-fill"></i> @L["Cv_Default"]
                                    </span>
                                }
                            </div>
                            <p class="cv-date">
                                <i class="bi bi-calendar"></i> @L["Cv_Uploaded", cv.UploadedDate.ShortDate()]
                            </p>
                            <p class="cv-url">
                                @if (cv.HasFile)
                                {
                                    <i class="bi bi-paperclip"></i>
                                    <span>@cv.FileName</span>
                                    <span class="text-muted">(@FormatSize(cv.SizeBytes))</span>
                                }
                                else
                                {
                                    <i class="bi bi-file-earmark"></i>
                                    <span class="text-muted">@L["Cv_NoFile"]</span>
                                }
                            </p>
                        </div>
                        <div class="cv-actions">
                            @if (cv.HasFile)
                            {
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => DownloadCV(cv)" title="@L["Cv_Download"]">
                                    <i class="bi bi-download"></i>
                                </button>
                            }
                            @if (!cv.IsDefault)
                            {
                                <button class="btn btn-sm btn-outline-success" @onclick="() => SetAsDefault(cv.Id)" title="@L["Cv_SetDefault"]">
                                    <i class="bi bi-star"></i>
                                </button>
                            }
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ShowEditCVModal(cv)" title="@L["Common_Edit"]">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCV(cv.Id)" title="@L["Common_Delete"]">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-file-earmark-text"></i>
            <h4>@L["Cv_EmptyHeading"]</h4>
            <p>@L["Cv_EmptyBody"]</p>
            <button class="btn btn-primary" @onclick="ShowAddCVModal">
                <i class="bi bi-plus"></i> @L["Cv_UploadFirst"]
            </button>
        </div>
    }
</div>

@if (showCVModal)
{
    <div class="modal show" style="display: block; background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditMode ? L["Cv_EditTitle"] : L["Cv_AddTitle"])</h5>
                    <button type="button" class="btn-close" @onclick="CloseCVModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@L["Cv_NameLabel"]</label>
                        <input type="text" class="form-control" @bind="currentCV.Name" placeholder="@L["Cv_NamePlaceholder"]" />
                    </div>
                    @if (!isEditMode)
                    {
                        <div class="mb-3">
                            <label class="form-label">@L["Cv_FileLabel"]</label>
                            <InputFile class="form-control" OnChange="HandleFileSelected" accept=".pdf,.doc,.docx" />
                            <small class="form-text text-muted">@L["Cv_FileHint"]</small>
                        </div>
                    }
                    @if (!isEditMode)
                    {
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="setAsDefault" @bind="currentCV.IsDefault" />
                                <label class="form-check-label" for="setAsDefault">
                                    @L["Cv_SetAsDefaultCheckbox"]
                                </label>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseCVModal">@L["Common_Cancel"]</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveCV" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        @(isEditMode ? L["Cv_UpdateAction"] : L["Cv_AddAction"])
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CVVersionDto> cvVersions = new();
    private bool isLoading = true;
    private bool showCVModal = false;
    private bool isEditMode = false;
    private bool isSaving = false;
    private CVVersionDto currentCV = new();
    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? selectedFile;

    protected override async Task OnInitializedAsync()
    {
        await LoadCVVersions();
    }

    private async Task LoadCVVersions()
    {
        isLoading = true;
        try
        {
            cvVersions = await CVVersionService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading CV versions: {ex.Message}");
            ToastService.ShowError(L["Cv_LoadFailed"]);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAddCVModal()
    {
        currentCV = new CVVersionDto
        {
            Id = Guid.NewGuid().ToString(),
            UploadedDate = DateTime.UtcNow,
            IsDefault = !cvVersions.Any() // First CV is default
        };
        isEditMode = false;
        showCVModal = true;
    }

    private void ShowEditCVModal(CVVersionDto cv)
    {
        currentCV = new CVVersionDto
        {
            Id = cv.Id,
            Name = cv.Name,
            VersionNotes = cv.VersionNotes,
            UploadedDate = cv.UploadedDate,
            IsDefault = cv.IsDefault,
            FileName = cv.FileName,
            SizeBytes = cv.SizeBytes,
            HasFile = cv.HasFile
        };
        isEditMode = true;
        showCVModal = true;
    }

    private void CloseCVModal()
    {
        showCVModal = false;
        currentCV = new();
        selectedFile = null;
    }

    private void HandleFileSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        // Auto-fill name if empty
        if (string.IsNullOrWhiteSpace(currentCV.Name) && selectedFile != null)
        {
            currentCV.Name = Path.GetFileNameWithoutExtension(selectedFile.Name);
        }
    }

    private async Task SaveCV()
    {
        if (string.IsNullOrWhiteSpace(currentCV.Name))
        {
            return;
        }

        isSaving = true;
        try
        {
            if (isEditMode)
            {
                var updated = await CVVersionService.UpdateAsync(currentCV.Id, currentCV);
                var index = cvVersions.FindIndex(cv => cv.Id == currentCV.Id);
                if (index >= 0)
                {
                    cvVersions[index] = updated;
                }
            }
            else
            {
                CVVersionDto created;
                if (selectedFile != null)
                {
                    // The upload carries the display name, so the record arrives
                    // correct in one round trip rather than being created and
                    // then patched.
                    using var stream = selectedFile.OpenReadStream(MaxUploadBytes);
                    created = await CVVersionService.UploadAsync(
                        currentCV.Name, selectedFile.Name, selectedFile.ContentType, stream);

                    if (currentCV.IsDefault && !created.IsDefault)
                    {
                        created = await CVVersionService.SetDefaultAsync(created.Id);
                        foreach (var other in cvVersions)
                        {
                            other.IsDefault = false;
                        }
                    }
                }
                else
                {
                    created = await CVVersionService.CreateAsync(currentCV);
                }
                cvVersions.Insert(0, created); // Add to top
            }
            CloseCVModal();
            ToastService.ShowSuccess(isEditMode ? L["Cv_Updated"] : L["Cv_Added"]);
        }
        catch (HttpRequestException ex)
        {
            // The server rejects by inspecting the bytes, so its reason is the
            // useful one - show it rather than a generic failure.
            Console.WriteLine($"Error saving CV: {ex.Message}");
            ToastService.ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving CV: {ex.Message}");
            ToastService.ShowError(L["Cv_SaveFailed"]);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SetAsDefault(string id)
    {
        try
        {
            var updated = await CVVersionService.SetDefaultAsync(id);

            // Update local list
            foreach (var cv in cvVersions)
            {
                cv.IsDefault = cv.Id == id;
            }

            StateHasChanged();
            ToastService.ShowSuccess(L["Cv_DefaultUpdated"]);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error setting default CV: {ex.Message}");
            ToastService.ShowError(L["Cv_SetDefaultFailed"]);
        }
    }

    private async Task DeleteCV(string id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", L["Cv_ConfirmDelete"].Value))
        {
            return;
        }

        try
        {
            await CVVersionService.DeleteAsync(id);
            cvVersions.RemoveAll(cv => cv.Id == id);
            ToastService.ShowSuccess(L["Cv_Deleted"]);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting CV: {ex.Message}");
            ToastService.ShowError(L["Cv_DeleteFailed"]);
        }
    }

    /// <summary>
    /// Matches the server limit, so an oversized file is refused here rather
    /// than being streamed all the way up only to be rejected.
    /// </summary>
    private const long MaxUploadBytes = 5 * 1024 * 1024;

    private async Task DownloadCV(CVVersionDto cv)
    {
        try
        {
            var link = await CVVersionService.GetDownloadLinkAsync(cv.Id);
            await JSRuntime.InvokeVoidAsync("open", link.Url, "_blank");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error downloading CV: {ex.Message}");
            ToastService.ShowError(L["Cv_OpenFailed"]);
        }
    }

    private string FormatSize(long bytes) =>
        bytes >= 1024 * 1024
            ? L["Cv_SizeMegabytes", (bytes / (double)(1024 * 1024)).ToString("0.#")]
            : L["Cv_SizeKilobytes", (bytes / 1024d).ToString("0.#")];
}
