@page "/meetings"
@using MiFuturoTrabajo.Shared.Models
@using MiFuturoTrabajo.Client.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using Blazored.Toast.Services
@attribute [Authorize]
@inject IMeetingService MeetingService
@inject IJobApplicationService JobApplicationService
@inject NavigationManager NavigationManager
@inject IToastService ToastService

<div class="meetings-container">
    <div class="page-header">
        <div class="header-left">
            <h2><i class="bi bi-camera-video"></i> @L["Nav_Meetings"]</h2>
            <p class="text-muted">@L["Meetings_Subheading"]</p>
        </div>
        <div class="header-actions">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" class="form-control" placeholder="@L["Meetings_SearchPlaceholder"]" 
                       @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleSearch" />
            </div>
            <div class="filter-group">
                <select class="form-select" @bind="timeFilter" @bind:after="FilterMeetings">
                    <option value="">@L["Meetings_AllMeetings"]</option>
                    <option value="upcoming">@L["Meetings_Upcoming"]</option>
                    <option value="past">@L["Meetings_Past"]</option>
                    <option value="today">@L["Common_Today"]</option>
                    <option value="thisWeek">@L["Meetings_ThisWeek"]</option>
                </select>
                <select class="form-select" @bind="typeFilter" @bind:after="FilterMeetings">
                    <option value="">@L["Tasks_AllTypes"]</option>
                    <option value="online">@L["Meetings_Online"]</option>
                    <option value="phone">@L["Meetings_Phone"]</option>
                    <option value="inPerson">@L["Meetings_InPerson"]</option>
                </select>
            </div>
            <button class="btn btn-primary" @onclick="CreateNew">
                <i class="bi bi-plus-lg"></i> @L["Meetings_New"]
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@L["Common_Loading"]</span>
            </div>
            <p>@L["Common_Loading"]</p>
        </div>
    }
    else
    {
        <div class="stats-bar">
            <div class="stat-card">
                <div class="stat-icon bg-primary"><i class="bi bi-calendar-event"></i></div>
                <div class="stat-content">
                    <h3>@meetings.Count</h3>
                    <p>@L["Meetings_StatTotal"]</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon bg-info"><i class="bi bi-clock-history"></i></div>
                <div class="stat-content">
                    <h3>@meetings.Count(m => m.StartDateTime > DateTime.Now)</h3>
                    <p>@L["Meetings_Upcoming"]</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon bg-warning"><i class="bi bi-calendar-check"></i></div>
                <div class="stat-content">
                    <h3>@meetings.Count(m => m.StartDateTime.Date == DateTime.Today)</h3>
                    <p>@L["Common_Today"]</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon bg-success"><i class="bi bi-check-circle"></i></div>
                <div class="stat-content">
                    <h3>@meetings.Count(m => m.StartDateTime < DateTime.Now)</h3>
                    <p>@L["Tasks_Completed"]</p>
                </div>
            </div>
        </div>

        <div class="view-controls">
            <div class="view-toggle">
                <button class="btn btn-sm @(viewMode == "list" ? "btn-primary" : "btn-outline-secondary")"
                        @onclick='() => viewMode = "list"'>
                    <i class="bi bi-list-ul"></i> @L["Applications_ViewList"]
                </button>
                <button class="btn btn-sm @(viewMode == "timeline" ? "btn-primary" : "btn-outline-secondary")"
                        @onclick='() => viewMode = "timeline"'>
                    <i class="bi bi-clock-history"></i> @L["Meetings_ViewTimeline"]
                </button>
            </div>
            <div class="sort-controls">
                <select class="form-select form-select-sm" @bind="sortBy" @bind:after="SortMeetings">
                    <option value="startDate">@L["Meetings_ColStartDate"]</option>
                    <option value="title">@L["TaskForm_TitleLabel"]</option>
                    <option value="company">@L["Applications_ColCompany"]</option>
                </select>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleSortOrder">
                    <i class="bi bi-sort-@(sortAscending ? "down" : "up")"></i>
                </button>
            </div>
            <span class="results-count">@L["Applications_ResultsCount", filteredMeetings.Count, meetings.Count]</span>
        </div>

        @if (!filteredMeetings.Any())
        {
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <h4>@L["Meetings_EmptyHeading"]</h4>
                <p>@(string.IsNullOrEmpty(searchTerm) ? L["Meetings_EmptyBody"] : L["Applications_NoMatches"])</p>
                @if (string.IsNullOrEmpty(searchTerm))
                {
                    <button class="btn btn-primary" @onclick="CreateNew">
                        <i class="bi bi-plus-lg"></i> @L["Meetings_ScheduleFirst"]
                    </button>
                }
            </div>
        }
        else if (viewMode == "list")
        {
            <div class="meetings-list">
                @foreach (var meeting in filteredMeetings)
                {
                    var isPast = meeting.StartDateTime < DateTime.Now;
                    var isToday = meeting.StartDateTime.Date == DateTime.Today;
                    var isUpcoming = meeting.StartDateTime > DateTime.Now && !isToday;

                    <div class="meeting-card @(isPast ? "past" : isToday ? "today" : "upcoming")" 
                         @onclick="() => ViewDetails(meeting.Id)">
                        <div class="meeting-date">
                            <div class="date-box">
                                <span class="month">@meeting.StartDateTime.AbbreviatedMonth()</span>
                                <span class="day">@meeting.StartDateTime.Day</span>
                                <span class="year">@meeting.StartDateTime.Year</span>
                            </div>
                            <div class="time-info">
                                <div class="time">
                                    <i class="bi bi-clock"></i>
                                    @meeting.StartDateTime.ShortTime()
                                </div>
                                <div class="duration">
                                    @if (meeting.EndDateTime != default)
                                    {
                                        var duration = meeting.EndDateTime - meeting.StartDateTime;
                                        <span>@L["Meetings_DurationMinutes", (int)duration.TotalMinutes]</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="meeting-content">
                            <div class="meeting-header">
                                <div class="meeting-title">
                                    <h5>@meeting.Title</h5>
                                    @if (isToday)
                                    {
                                        <span class="badge bg-warning">@L["Common_Today"]</span>
                                    }
                                    else if (isUpcoming)
                                    {
                                        var hoursUntil = (meeting.StartDateTime - DateTime.Now).TotalHours;
                                        if (hoursUntil < 24)
                                        {
                                            <span class="badge bg-danger">@L["Meetings_InHours", (int)hoursUntil]</span>
                                        }
                                    }
                                    @if (meeting.IsPhonecall)
                                    {
                                        <span class="badge bg-info"><i class="bi bi-telephone"></i> @L["Meetings_Phone"]</span>
                                    }
                                    else if (!string.IsNullOrEmpty(meeting.OnlineMeetingURL))
                                    {
                                        <span class="badge bg-primary"><i class="bi bi-camera-video"></i> @L["Meetings_Online"]</span>
                                    }
                                    else if (!string.IsNullOrEmpty(meeting.PhysicalLocation))
                                    {
                                        <span class="badge bg-secondary"><i class="bi bi-geo-alt"></i> @L["Meetings_InPerson"]</span>
                                    }
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(meeting.Description))
                            {
                                <p class="meeting-description">@meeting.Description</p>
                            }

                            <div class="meeting-details">
                                @if (!string.IsNullOrEmpty(meeting.JobApplicationId) && jobApplications.TryGetValue(meeting.JobApplicationId, out var app))
                                {
                                    <div class="detail-item">
                                        <i class="bi bi-briefcase"></i>
                                        <span>@app.Company?.Name - @app.JobTitle</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(meeting.OnlineMeetingURL))
                                {
                                    <div class="detail-item">
                                        <i class="bi bi-link-45deg"></i>
                                        <a href="@meeting.OnlineMeetingURL" target="_blank" @onclick:stopPropagation="true">
                                            @L["Meetings_JoinOnline"]
                                        </a>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(meeting.MeetingAccessCode))
                                {
                                    <div class="detail-item">
                                        <i class="bi bi-key"></i>
                                        <span>@L["Meetings_AccessCode", meeting.MeetingAccessCode]</span>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(meeting.PhysicalLocation))
                                {
                                    <div class="detail-item">
                                        <i class="bi bi-geo-alt"></i>
                                        <span>@meeting.PhysicalLocation</span>
                                    </div>
                                }

                                @if (meeting.Recruiters.Any())
                                {
                                    <div class="detail-item">
                                        <i class="bi bi-people"></i>
                                        <span>@string.Join(", ", meeting.Recruiters.Select(r => $"{r.Name} {r.Lastname}"))</span>
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(meeting.Outcome) && isPast)
                            {
                                <div class="meeting-outcome">
                                    <strong>@L["Meetings_OutcomeLabel"]</strong> @meeting.Outcome
                                </div>
                            }

                            @if (meeting.FollowUpMeetings.Any())
                            {
                                <div class="follow-ups">
                                    <i class="bi bi-arrow-right-circle"></i>
                                    <span>@L.Plural("Meetings_FollowUpCount", meeting.FollowUpMeetings.Count)</span>
                                </div>
                            }
                        </div>

                        <div class="meeting-actions" @onclick:stopPropagation="true">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => EditMeeting(meeting.Id)" title="@L["Common_Edit"]">
                                <i class="bi bi-pencil"></i>
                            </button>
                            @if (!isPast && !string.IsNullOrEmpty(meeting.OnlineMeetingURL))
                            {
                                <a href="@meeting.OnlineMeetingURL" target="_blank" class="btn btn-sm btn-success" title="@L["Meetings_Join"]">
                                    <i class="bi bi-camera-video"></i>
                                </a>
                            }
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteMeeting(meeting.Id)" title="@L["Common_Delete"]">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="meetings-timeline">
                @{
                    var groupedByDate = filteredMeetings.GroupBy(m => m.StartDateTime.Date).OrderBy(g => g.Key);
                }
                @foreach (var dateGroup in groupedByDate)
                {
                    <div class="timeline-date-group">
                        <div class="date-header">
                            <h4>@dateGroup.Key.LongDate()</h4>
                            @if (dateGroup.Key == DateTime.Today)
                            {
                                <span class="badge bg-warning">@L["Common_Today"]</span>
                            }
                            else if (dateGroup.Key == DateTime.Today.AddDays(1))
                            {
                                <span class="badge bg-info">@L["Meetings_Tomorrow"]</span>
                            }
                        </div>
                        
                        <div class="timeline-items">
                            @foreach (var meeting in dateGroup.OrderBy(m => m.StartDateTime))
                            {
                                <div class="timeline-item" @onclick="() => ViewDetails(meeting.Id)">
                                    <div class="timeline-marker"></div>
                                    <div class="timeline-content">
                                        <div class="timeline-time">
                                            @meeting.StartDateTime.ShortTime()
                                            @if (meeting.EndDateTime != default)
                                            {
                                                <span> - @meeting.EndDateTime.ShortTime()</span>
                                            }
                                        </div>
                                        <div class="timeline-details">
                                            <h6>@meeting.Title</h6>
                                            @if (!string.IsNullOrEmpty(meeting.JobApplicationId) && jobApplications.TryGetValue(meeting.JobApplicationId, out var app))
                                            {
                                                <p class="company-info">
                                                    <i class="bi bi-briefcase"></i>
                                                    @app.Company?.Name - @app.JobTitle
                                                </p>
                                            }
                                            <div class="meeting-tags">
                                                @if (meeting.IsPhonecall)
                                                {
                                                    <span class="badge bg-info"><i class="bi bi-telephone"></i> @L["Meetings_Phone"]</span>
                                                }
                                                else if (!string.IsNullOrEmpty(meeting.OnlineMeetingURL))
                                                {
                                                    <span class="badge bg-primary"><i class="bi bi-camera-video"></i> @L["Meetings_Online"]</span>
                                                }
                                                @if (meeting.Recruiters.Any())
                                                {
                                                    <span class="badge bg-secondary">
                                                        <i class="bi bi-people"></i> @L.Plural("Meetings_RecruiterCount", meeting.Recruiters.Count)
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private List<MeetingDto> meetings = new();
    private List<MeetingDto> filteredMeetings = new();
    private Dictionary<string, JobApplicationDto> jobApplications = new();
    private bool isLoading = true;
    private string searchTerm = "";
    private string timeFilter = "";
    private string typeFilter = "";
    private string sortBy = "startDate";
    private bool sortAscending = true;
    private string viewMode = "list";

    protected override async Task OnInitializedAsync()
    {
        await LoadMeetings();
    }

    private async Task LoadMeetings()
    {
        isLoading = true;
        try
        {
            meetings = await MeetingService.GetAllAsync();
            var applications = await JobApplicationService.GetAllAsync();
            jobApplications = applications.ToDictionary(a => a.Id, a => a);
            FilterMeetings();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading meetings: {ex.Message}");
            ToastService.ShowError(L["Meetings_LoadFailed"]);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterMeetings()
    {
        filteredMeetings = meetings.AsEnumerable().ToList();

        if (!string.IsNullOrEmpty(searchTerm))
        {
            filteredMeetings = filteredMeetings.Where(m =>
                (m.Title?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (m.Description?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (m.PhysicalLocation?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
            ).ToList();
        }

        if (!string.IsNullOrEmpty(timeFilter))
        {
            var now = DateTime.Now;
            filteredMeetings = timeFilter switch
            {
                "upcoming" => filteredMeetings.Where(m => m.StartDateTime > now).ToList(),
                "past" => filteredMeetings.Where(m => m.StartDateTime < now).ToList(),
                "today" => filteredMeetings.Where(m => m.StartDateTime.Date == DateTime.Today).ToList(),
                "thisWeek" => filteredMeetings.Where(m => 
                    m.StartDateTime >= now.Date && 
                    m.StartDateTime < now.Date.AddDays(7)).ToList(),
                _ => filteredMeetings.ToList()
            };
        }

        if (!string.IsNullOrEmpty(typeFilter))
        {
            filteredMeetings = typeFilter switch
            {
                "online" => filteredMeetings.Where(m => !string.IsNullOrEmpty(m.OnlineMeetingURL)).ToList(),
                "phone" => filteredMeetings.Where(m => m.IsPhonecall).ToList(),
                "inPerson" => filteredMeetings.Where(m => !string.IsNullOrEmpty(m.PhysicalLocation)).ToList(),
                _ => filteredMeetings.ToList()
            };
        }

        SortMeetings();
    }

    private void SortMeetings()
    {
        filteredMeetings = sortBy switch
        {
            "title" => sortAscending
                ? filteredMeetings.OrderBy(m => m.Title).ToList()
                : filteredMeetings.OrderByDescending(m => m.Title).ToList(),
            "company" => sortAscending
                ? filteredMeetings.OrderBy(m => GetCompanyName(m)).ToList()
                : filteredMeetings.OrderByDescending(m => GetCompanyName(m)).ToList(),
            _ => sortAscending
                ? filteredMeetings.OrderBy(m => m.StartDateTime).ToList()
                : filteredMeetings.OrderByDescending(m => m.StartDateTime).ToList()
        };
    }

    private string GetCompanyName(MeetingDto meeting)
    {
        if (!string.IsNullOrEmpty(meeting.JobApplicationId) && 
            jobApplications.TryGetValue(meeting.JobApplicationId, out var app))
        {
            return app.Company?.Name ?? "";
        }
        return "";
    }

    private void ToggleSortOrder()
    {
        sortAscending = !sortAscending;
        SortMeetings();
    }

    private void HandleSearch()
    {
        FilterMeetings();
    }

    private void ViewDetails(string id)
    {
        NavigationManager.NavigateTo($"/meetings/{id}");
    }

    private void EditMeeting(string id)
    {
        NavigationManager.NavigateTo($"/meetings/{id}");
    }

    private async Task DeleteMeeting(string id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", L["Meetings_ConfirmDelete"].Value))
        {
            try
            {
                await MeetingService.DeleteAsync(id);
                await LoadMeetings();
                ToastService.ShowSuccess(L["Meetings_Deleted"]);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting meeting: {ex.Message}");
                ToastService.ShowError(L["Meetings_DeleteFailed"]);
            }
        }
    }

    private void CreateNew()
    {
        NavigationManager.NavigateTo("/meetings/new");
    }

    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
}
