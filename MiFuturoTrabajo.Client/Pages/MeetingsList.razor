        position: absolute;
        left: -28px;
        top: 20px;
        width: 16px;
        height: 16px;
        background: #0d6efd;
        border: 3px solid white;
        border-radius: 50%;
        box-shadow: 0 0 0 2px #0d6efd;
    }

    .timeline-content {
        background: #f8f9fa;
        padding: 16px;
