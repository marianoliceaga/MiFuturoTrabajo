@page "/register"
@inject IAuthenticationService AuthService
@inject NavigationManager Navigation
@inject Blazored.Toast.Services.IToastService ToastService
@inject IJSRuntime JSRuntime
@using MiFuturoTrabajo.Shared.Models
@implements IDisposable

<PageTitle>Register - MiFuturoTrabajo</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h2 class="card-title text-center mb-4">Create Account</h2>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @errorMessage
                        </div>
                    }

                    <EditForm Model="@registerRequest" OnValidSubmit="@HandleRegister">
                        <DataAnnotationsValidator />

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="firstName" class="form-label">First Name</label>
                                <InputText id="firstName" class="form-control" @bind-Value="registerRequest.FirstName" placeholder="John" />
                                <ValidationMessage For="@(() => registerRequest.FirstName)" />
                            </div>
                            <div class="col-md-6">
                                <label for="lastName" class="form-label">Last Name</label>
                                <InputText id="lastName" class="form-control" @bind-Value="registerRequest.LastName" placeholder="Doe" />
                                <ValidationMessage For="@(() => registerRequest.LastName)" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <InputText id="email" type="email" class="form-control" @bind-Value="registerRequest.Email" placeholder="your@email.com" />
                            <ValidationMessage For="@(() => registerRequest.Email)" />
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">Password</label>
                            <div class="input-group">
                                <InputText id="password" type="@passwordInputType" class="form-control" @bind-Value="registerRequest.Password" placeholder="At least 8 characters" />
                                <button class="btn btn-outline-secondary" type="button" @onclick="TogglePasswordVisibility">
                                    @(showPassword ? "Hide" : "Show")
                                </button>
                            </div>
                            <ValidationMessage For="@(() => registerRequest.Password)" />
                            <div class="form-text">Must be at least 8 characters long</div>
                        </div>

                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">Confirm Password</label>
                            <div class="input-group">
                                <InputText id="confirmPassword" type="@confirmPasswordInputType" class="form-control" @bind-Value="registerRequest.ConfirmPassword" placeholder="Re-enter your password" />
                                <button class="btn btn-outline-secondary" type="button" @onclick="ToggleConfirmPasswordVisibility">
                                    @(showConfirmPassword ? "Hide" : "Show")
                                </button>
                            </div>
                            <ValidationMessage For="@(() => registerRequest.ConfirmPassword)" />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Creating account...</span>
                                }
                                else
                                {
                                    <span>Create Account</span>
                                }
                            </button>
                        </div>
                    </EditForm>

                    <hr class="my-4" />

                    <div class="text-center mb-3">
                        <p class="text-muted">Or sign up with</p>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button type="button" class="btn btn-outline-danger" @onclick="HandleGoogleSignUp" disabled="@isOAuthLoading">
                            @if (isOAuthLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-google me-2" viewBox="0 0 16 16">
                                <path d="M15.545 6.558a9.42 9.42 0 0 1 .139 1.626c0 2.434-.87 4.492-2.384 5.885h.002C11.978 15.292 10.158 16 8 16A8 8 0 1 1 8 0a7.689 7.689 0 0 1 5.352 2.082l-2.284 2.284A4.347 4.347 0 0 0 8 3.166c-2.087 0-3.86 1.408-4.492 3.304a4.792 4.792 0 0 0 0 3.063h.003c.635 1.893 2.405 3.301 4.492 3.301 1.078 0 2.004-.276 2.722-.764h-.003a3.702 3.702 0 0 0 1.599-2.431H8v-3.08h7.545z"/>
                            </svg>
                            Sign up with Google
                        </button>
                    </div>

                    <hr class="my-4" />

                    <div class="text-center">
                        <p class="mb-0">
                            Already have an account? <a href="/login" class="text-decoration-none fw-bold">Login</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterRequest registerRequest = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool isOAuthLoading = false;
    private DotNetObjectReference<Register>? objRef;

    private bool showPassword = false;
    private string passwordInputType => showPassword ? "text" : "password";

    private bool showConfirmPassword = false;
    private string confirmPasswordInputType => showConfirmPassword ? "text" : "password";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("setGoogleCallback", objRef);
        }
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private void ToggleConfirmPasswordVisibility()
    {
        showConfirmPassword = !showConfirmPassword;
    }

    private async Task HandleGoogleSignUp()
    {
        try
        {
            isOAuthLoading = true;
            errorMessage = string.Empty;
            StateHasChanged();

            await JSRuntime.InvokeVoidAsync("signInWithGoogle");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to initiate Google sign-up. Please try again.";
            Console.WriteLine($"Google sign-up error: {ex.Message}");
            ToastService.ShowError("Google sign-up failed");
            isOAuthLoading = false;
        }
    }

    [JSInvokable]
    public void HandleGoogleCancelled()
    {
        isOAuthLoading = false;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task HandleGoogleCredential(string credential)
    {
        try
        {
            var oauthRequest = new OAuthLoginRequest
            {
                Provider = OAuthProvider.Google,
                IdToken = credential
            };

            var result = await AuthService.OAuthLoginAsync(oauthRequest);

            if (result != null)
            {
                ToastService.ShowSuccess("Account created successfully with Google! Welcome!");
                Navigation.NavigateTo("/", forceLoad: true);
            }
            else
            {
                errorMessage = "Google sign-up failed. Please try again.";
                ToastService.ShowError("Google sign-up failed");
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Console.WriteLine($"Google credential processing error: {ex.Message}");
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            isOAuthLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleRegister()
    {
        errorMessage = string.Empty;
        isLoading = true;

        try
        {
            // Validate passwords match
            if (registerRequest.Password != registerRequest.ConfirmPassword)
            {
                errorMessage = "Passwords do not match.";
                isLoading = false;
                return;
            }

            // Validate password length
            if (registerRequest.Password.Length < 8)
            {
                errorMessage = "Password must be at least 8 characters long.";
                isLoading = false;
                return;
            }

            var result = await AuthService.RegisterAsync(registerRequest);

            if (result != null)
            {
                ToastService.ShowSuccess("Registration successful! Welcome!");
                Navigation.NavigateTo("/", forceLoad: true);
            }
            else
            {
                errorMessage = "Registration failed. Email may already be in use.";
                ToastService.ShowError("Registration failed");
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Console.WriteLine($"Registration error: {ex.Message}");
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }
}
