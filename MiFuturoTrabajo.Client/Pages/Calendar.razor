@page "/calendar"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject ICalendarService CalendarService
@using MiFuturoTrabajo.Shared.Models
@using System.Globalization

<PageTitle>@L["Nav_Calendar"]</PageTitle>

<div class="calendar-container">
    <div class="calendar-header">
        <h2 class="month-title">@CurrentMonth.MonthAndYear()</h2>
        <div class="calendar-controls">
            <button class="btn btn-outline-secondary" @onclick="PrevMonth" aria-label="@L["Calendar_PreviousMonth"]">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button class="btn btn-outline-secondary" @onclick="GoToToday">@L["Common_Today"]</button>
            <button class="btn btn-outline-secondary" @onclick="NextMonth" aria-label="@L["Calendar_NextMonth"]">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@L["Common_Loading"]</span>
            </div>
        </div>
    }
    else
    {
        <div class="calendar-grid">
            @foreach (var dayName in DayNames)
            {
                <div class="calendar-day-header">@dayName</div>
            }

            @foreach (var day in CalendarDays)
            {
                <div class="calendar-day @(day.IsCurrentMonth ? "" : "other-month") @(IsToday(day.Date) ? "today" : "")">
                    <span class="day-number">@day.Date.Day</span>
                    <div class="events-list">
                        @foreach (var evt in day.Events)
                        {
                            <a href="@evt.Url" class="event-item badge @evt.ColorClass text-truncate" title="@evt.Title">
                                @if (evt.Type == CalendarEventType.Task)
                                {
                                    <i class="bi bi-check-square me-1"></i>
                                }
                                else if (evt.Type == CalendarEventType.Meeting)
                                {
                                    <i class="bi bi-camera-video me-1"></i>
                                }
                                else if (evt.Type == CalendarEventType.InterviewStep)
                                {
                                    <i class="bi bi-people me-1"></i>
                                }
                                else if (evt.Type == CalendarEventType.ApplicationDeadline)
                                {
                                    <i class="bi bi-exclamation-circle me-1"></i>
                                }
                                @evt.Title
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private DateTime CurrentMonth { get; set; } = DateTime.Today;
    private List<CalendarEvent> AllEvents { get; set; } = new();
    private List<CalendarDay> CalendarDays { get; set; } = new();
    private bool IsLoading { get; set; } = true;

    /// <summary>
    /// Which day a week starts on, per the active culture: Sunday in en, Monday
    /// in es. The grid used to hard-code Sunday, so a Spanish calendar was laid
    /// out a day off from every other calendar its reader uses.
    /// </summary>
    private static DayOfWeek FirstDayOfWeek => CultureInfo.CurrentCulture.DateTimeFormat.FirstDayOfWeek;

    /// <summary>
    /// AbbreviatedDayNames is always indexed Sunday-first regardless of
    /// culture, so it is rotated to match the column order rather than used as
    /// it comes.
    /// </summary>
    private static string[] DayNames =>
        Enumerable.Range(0, 7)
            .Select(offset => CultureInfo.CurrentCulture.DateTimeFormat
                .AbbreviatedDayNames[((int)FirstDayOfWeek + offset) % 7])
            .ToArray();

    protected override async Task OnInitializedAsync()
    {
        CurrentMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        await LoadEvents();
    }

    private async Task LoadEvents()
    {
        IsLoading = true;
        try
        {
            AllEvents = await CalendarService.GetEventsAsync();
            BuildCalendar();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading calendar: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void BuildCalendar()
    {
        CalendarDays.Clear();

        var firstDayOfMonth = CurrentMonth;
        var lastDayOfMonth = CurrentMonth.AddMonths(1).AddDays(-1);

        // Back up to the start of the week the 1st falls in, and forward to the
        // end of the week the last day falls in, both relative to the culture's
        // first day rather than to Sunday.
        var startDate = firstDayOfMonth.AddDays(-DaysSinceWeekStart(firstDayOfMonth));
        var endDate = lastDayOfMonth.AddDays(6 - DaysSinceWeekStart(lastDayOfMonth));

        // Ensure we show at least 6 weeks for consistent height
        if ((endDate - startDate).Days < 41)
        {
            endDate = endDate.AddDays(7);
        }

        for (var date = startDate; date <= endDate; date = date.AddDays(1))
        {
            var eventsForDay = AllEvents
            .Where(e => e.Start.Date == date.Date)
            .OrderBy(e => e.Start)
            .ToList();

            CalendarDays.Add(new CalendarDay
            {
                Date = date,
                IsCurrentMonth = date.Month == CurrentMonth.Month,
                Events = eventsForDay
            });
        }
    }

    private static int DaysSinceWeekStart(DateTime date) =>
        ((int)date.DayOfWeek - (int)FirstDayOfWeek + 7) % 7;

    private void PrevMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(-1);
        BuildCalendar();
    }

    private void NextMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(1);
        BuildCalendar();
    }

    private void GoToToday()
    {
        CurrentMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        BuildCalendar();
    }

    private bool IsToday(DateTime date)
    {
        return date.Date == DateTime.Today;
    }

    private class CalendarDay
    {
        public DateTime Date { get; set; }
        public bool IsCurrentMonth { get; set; }
        public List<CalendarEvent> Events { get; set; } = new();
    }
}
