@page "/tasks"
@using MiFuturoTrabajo.Shared.Models
@using MiFuturoTrabajo.Client.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using Blazored.Toast.Services
@attribute [Authorize]
@inject IApplicantTaskService TaskService
@inject IJobApplicationService JobApplicationService
@inject NavigationManager NavigationManager
@inject IToastService ToastService

<div class="tasks-container">
    <div class="page-header">
        <div class="header-left">
            <h2><i class="bi bi-check-square"></i> @L["Nav_Tasks"]</h2>
            <p class="text-muted">@L["Tasks_Subheading"]</p>
        </div>
        <div class="header-actions">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" class="form-control" placeholder="@L["Tasks_SearchPlaceholder"]" 
                       @bind="searchTerm" @bind:event="oninput" @onkeyup="HandleSearch" />
            </div>
            <div class="filter-group">
                <select class="form-select" @bind="statusFilter" @bind:after="FilterTasks">
                    <option value="">@L["Tasks_AllTasks"]</option>
                    <option value="active">@L["Tasks_Active"]</option>
                    <option value="completed">@L["Tasks_Completed"]</option>
                    <option value="overdue">@L["Tasks_Overdue"]</option>
                </select>
                <select class="form-select" @bind="typeFilter" @bind:after="FilterTasks">
                    <option value="">@L["Tasks_AllTypes"]</option>
                    @foreach (TaskType type in Enum.GetValues(typeof(TaskType)))
                    {
                        <option value="@type">@L.Enum(type)</option>
                    }
                </select>
            </div>
            <button class="btn btn-primary" @onclick="CreateNew">
                <i class="bi bi-plus-lg"></i> @L["Tasks_New"]
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@L["Common_Loading"]</span>
            </div>
            <p>@L["Common_Loading"]</p>
        </div>
    }
    else
    {
        <div class="stats-bar">
            <div class="stat-card">
                <div class="stat-icon bg-primary"><i class="bi bi-list-task"></i></div>
                <div class="stat-content">
                    <h3>@tasks.Count</h3>
                    <p>@L["Tasks_StatTotal"]</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon bg-warning"><i class="bi bi-hourglass-split"></i></div>
                <div class="stat-content">
                    <h3>@tasks.Count(t => !t.Completed)</h3>
                    <p>@L["Tasks_Active"]</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon bg-danger"><i class="bi bi-exclamation-triangle"></i></div>
                <div class="stat-content">
                    <h3>@tasks.Count(t => !t.Completed && t.Deadline < DateTime.Now)</h3>
                    <p>@L["Tasks_Overdue"]</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon bg-success"><i class="bi bi-check-circle"></i></div>
                <div class="stat-content">
                    <h3>@tasks.Count(t => t.Completed)</h3>
                    <p>@L["Tasks_Completed"]</p>
                </div>
            </div>
        </div>

        <div class="view-controls">
            <div class="view-toggle">
                <button class="btn btn-sm @(viewMode == "list" ? "btn-primary" : "btn-outline-secondary")"
                        @onclick='() => viewMode = "list"'>
                    <i class="bi bi-list-ul"></i> @L["Applications_ViewList"]
                </button>
                <button class="btn btn-sm @(viewMode == "kanban" ? "btn-primary" : "btn-outline-secondary")"
                        @onclick='() => viewMode = "kanban"'>
                    <i class="bi bi-kanban"></i> @L["Nav_Board"]
                </button>
            </div>
            <div class="sort-controls">
                <select class="form-select form-select-sm" @bind="sortBy" @bind:after="SortTasks">
                    <option value="deadline">@L["Applications_ColDeadline"]</option>
                    <option value="type">@L["Tasks_ColType"]</option>
                    <option value="created">@L["Tasks_ColCreated"]</option>
                </select>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleSortOrder">
                    <i class="bi bi-sort-@(sortAscending ? "down" : "up")"></i>
                </button>
            </div>
            <span class="results-count">@L["Applications_ResultsCount", filteredTasks.Count, tasks.Count]</span>
        </div>

        @if (!filteredTasks.Any())
        {
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <h4>@L["Tasks_EmptyHeading"]</h4>
                <p>@(string.IsNullOrEmpty(searchTerm) ? L["Tasks_EmptyBody"] : L["Applications_NoMatches"])</p>
                @if (string.IsNullOrEmpty(searchTerm))
                {
                    <button class="btn btn-primary" @onclick="CreateNew">
                        <i class="bi bi-plus-lg"></i> @L["Tasks_CreateFirst"]
                    </button>
                }
            </div>
        }
        else if (viewMode == "list")
        {
            <div class="tasks-list">
                @foreach (var task in filteredTasks)
                {
                    <div class="task-card @(task.Completed ? "completed" : "") @(IsOverdue(task) ? "overdue" : "")">
                        <div class="task-checkbox" @onclick:stopPropagation="true">
                            <input type="checkbox" checked="@task.Completed" 
                                   @onchange="() => ToggleComplete(task)" />
                        </div>
                        <div class="task-content" @onclick="() => EditTask(task.Id)">
                            <div class="task-header">
                                <div class="task-title">
                                    <h5>@(string.IsNullOrWhiteSpace(task.Title) ? L.Enum(task.Type) : task.Title)</h5>
                                    <span class="badge task-type-@task.Type.ToString().ToLower()">
                                        @L.Enum(task.Type)
                                    </span>
                                </div>
                                <div class="task-deadline">
                                    <i class="bi bi-calendar"></i>
                                    <span class="@(IsOverdue(task) && !task.Completed ? "text-danger" : "")">
                                        @task.Deadline.ShortDate()
                                    </span>
                                    @if (!task.Completed)
                                    {
                                        var daysUntil = (task.Deadline - DateTime.Now).Days;
                                        if (daysUntil < 0)
                                        {
                                            <small class="text-danger d-block">@L.Plural("Tasks_DaysOverdue", Math.Abs(daysUntil))</small>
                                        }
                                        else if (daysUntil <= 3)
                                        {
                                            <small class="text-warning d-block">@L.Plural("Tasks_DueInDays", daysUntil)</small>
                                        }
                                    }
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(task.Note))
                            {
                                <p class="task-note">@task.Note</p>
                            }
                            @if (!string.IsNullOrEmpty(task.JobApplicationId) && jobApplications.TryGetValue(task.JobApplicationId, out var app))
                            {
                                <div class="task-application">
                                    <i class="bi bi-briefcase"></i>
                                    <span>@app.Company?.Name - @app.JobTitle</span>
                                </div>
                            }
                        </div>
                        <div class="task-actions" @onclick:stopPropagation="true">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => EditTask(task.Id)" title="@L["Common_Edit"]">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteTask(task.Id)" title="@L["Common_Delete"]">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="tasks-kanban">
                <div class="kanban-column">
                    <div class="column-header bg-warning">
                        <h5>@L["Tasks_ColumnToDo"]</h5>
                        <span class="badge bg-white text-dark">@filteredTasks.Count(t => !t.Completed && !IsOverdue(t))</span>
                    </div>
                    <div class="column-body">
                        @foreach (var task in filteredTasks.Where(t => !t.Completed && !IsOverdue(t)))
                        {
                            <div class="kanban-card" @onclick="() => EditTask(task.Id)">
                                <div class="card-header">
                                    <input type="checkbox" checked="@task.Completed" 
                                           @onchange="() => ToggleComplete(task)" 
                                           @onclick:stopPropagation="true" />
                                    <span class="badge task-type-@task.Type.ToString().ToLower()">
                                        @L.Enum(task.Type)
                                    </span>
                                </div>
                                <h6>@(string.IsNullOrWhiteSpace(task.Title) ? L.Enum(task.Type) : task.Title)</h6>
                                @if (!string.IsNullOrEmpty(task.Note))
                                {
                                    <p class="card-note">@task.Note</p>
                                }
                                <div class="card-footer">
                                    <small><i class="bi bi-calendar"></i> @task.Deadline.ShortDate()</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="kanban-column">
                    <div class="column-header bg-danger">
                        <h5>@L["Tasks_Overdue"]</h5>
                        <span class="badge bg-white text-dark">@filteredTasks.Count(t => !t.Completed && IsOverdue(t))</span>
                    </div>
                    <div class="column-body">
                        @foreach (var task in filteredTasks.Where(t => !t.Completed && IsOverdue(t)))
                        {
                            <div class="kanban-card overdue" @onclick="() => EditTask(task.Id)">
                                <div class="card-header">
                                    <input type="checkbox" checked="@task.Completed" 
                                           @onchange="() => ToggleComplete(task)" 
                                           @onclick:stopPropagation="true" />
                                    <span class="badge task-type-@task.Type.ToString().ToLower()">
                                        @L.Enum(task.Type)
                                    </span>
                                </div>
                                <h6>@(string.IsNullOrWhiteSpace(task.Title) ? L.Enum(task.Type) : task.Title)</h6>
                                @if (!string.IsNullOrEmpty(task.Note))
                                {
                                    <p class="card-note">@task.Note</p>
                                }
                                <div class="card-footer">
                                    <small class="text-danger">
                                        <i class="bi bi-exclamation-triangle"></i>
                                        @L.Plural("Tasks_DaysOverdue", Math.Abs((task.Deadline - DateTime.Now).Days))
                                    </small>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="kanban-column">
                    <div class="column-header bg-success">
                        <h5>@L["Tasks_Completed"]</h5>
                        <span class="badge bg-white text-dark">@filteredTasks.Count(t => t.Completed)</span>
                    </div>
                    <div class="column-body">
                        @foreach (var task in filteredTasks.Where(t => t.Completed))
                        {
                            <div class="kanban-card completed" @onclick="() => EditTask(task.Id)">
                                <div class="card-header">
                                    <input type="checkbox" checked="@task.Completed" 
                                           @onchange="() => ToggleComplete(task)" 
                                           @onclick:stopPropagation="true" />
                                    <span class="badge task-type-@task.Type.ToString().ToLower()">
                                        @L.Enum(task.Type)
                                    </span>
                                </div>
                                <h6>@(string.IsNullOrWhiteSpace(task.Title) ? L.Enum(task.Type) : task.Title)</h6>
                                @if (!string.IsNullOrEmpty(task.Note))
                                {
                                    <p class="card-note">@task.Note</p>
                                }
                                <div class="card-footer">
                                    <small><i class="bi bi-check-circle"></i> @L["Tasks_Completed"]</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<ApplicantTaskDto> tasks = new();
    private List<ApplicantTaskDto> filteredTasks = new();
    private Dictionary<string, JobApplicationDto> jobApplications = new();
    private bool isLoading = true;
    private string searchTerm = "";
    private string statusFilter = "";
    private string typeFilter = "";
    private string sortBy = "deadline";
    private bool sortAscending = true;
    private string viewMode = "list";

    protected override async Task OnInitializedAsync()
    {
        await LoadTasks();
    }

    private async Task LoadTasks()
    {
        isLoading = true;
        try
        {
            tasks = await TaskService.GetAllAsync();
            var applications = await JobApplicationService.GetAllAsync();
            jobApplications = applications.ToDictionary(a => a.Id, a => a);
            FilterTasks();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tasks: {ex.Message}");
            ToastService.ShowError(L["Tasks_LoadFailed"]);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterTasks()
    {
        filteredTasks = tasks.AsEnumerable().ToList();

        if (!string.IsNullOrEmpty(searchTerm))
        {
            filteredTasks = filteredTasks.Where(t =>
                (t.Title?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (t.Note?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                L.Enum(t.Type).Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            ).ToList();
        }

        if (!string.IsNullOrEmpty(statusFilter))
        {
            filteredTasks = statusFilter switch
            {
                "active" => filteredTasks.Where(t => !t.Completed).ToList(),
                "completed" => filteredTasks.Where(t => t.Completed).ToList(),
                "overdue" => filteredTasks.Where(t => !t.Completed && IsOverdue(t)).ToList(),
                _ => filteredTasks.ToList()
            };
        }

        if (!string.IsNullOrEmpty(typeFilter) && Enum.TryParse<TaskType>(typeFilter, out var type))
        {
            filteredTasks = filteredTasks.Where(t => t.Type == type).ToList();
        }

        SortTasks();
    }

    private void SortTasks()
    {
        filteredTasks = sortBy switch
        {
            "type" => sortAscending
                ? filteredTasks.OrderBy(t => t.Type).ToList()
                : filteredTasks.OrderByDescending(t => t.Type).ToList(),
            "created" => sortAscending
                ? filteredTasks.OrderBy(t => t.StartDate).ToList()
                : filteredTasks.OrderByDescending(t => t.StartDate).ToList(),
            _ => sortAscending
                ? filteredTasks.OrderBy(t => t.Deadline).ToList()
                : filteredTasks.OrderByDescending(t => t.Deadline).ToList()
        };
    }

    private void ToggleSortOrder()
    {
        sortAscending = !sortAscending;
        SortTasks();
    }

    private void HandleSearch()
    {
        FilterTasks();
    }

    private bool IsOverdue(ApplicantTaskDto task)
    {
        return task.Deadline < DateTime.Now;
    }

    private async Task ToggleComplete(ApplicantTaskDto task)
    {
        try
        {
            await TaskService.ToggleCompleteAsync(task.Id);
            task.Completed = !task.Completed;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling task: {ex.Message}");
            ToastService.ShowError(L["Tasks_ToggleFailed"]);
        }
    }

    private void EditTask(string id)
    {
        NavigationManager.NavigateTo($"/tasks/{id}");
    }

    private async Task DeleteTask(string id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", L["Tasks_ConfirmDelete"].Value))
        {
            try
            {
                await TaskService.DeleteAsync(id);
                await LoadTasks();
                ToastService.ShowSuccess(L["Tasks_Deleted"]);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting task: {ex.Message}");
                ToastService.ShowError(L["Tasks_DeleteFailed"]);
            }
        }
    }

    private void CreateNew()
    {
        NavigationManager.NavigateTo("/tasks/new");
    }

    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
}
