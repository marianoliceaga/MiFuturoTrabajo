@page "/profile"
@using MiFuturoTrabajo.Shared.Models
@using MiFuturoTrabajo.Client.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using Blazored.Toast.Services
@attribute [Authorize]
@inject IApplicantService ApplicantService
@inject ICVVersionService CVVersionService
@inject IJSRuntime JSRuntime
@inject IToastService ToastService

<div class="profile-container">
    <div class="profile-header">
        <h2>@L["Nav_MyProfile"]</h2>
        <button class="btn btn-primary" @onclick="ToggleEditMode">
            <i class="bi bi-pencil"></i> @(isEditing ? L["Common_Cancel"] : L["Profile_Edit"])
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading">@L["Common_Loading"]</div>
    }
    else if (applicant != null)
    {
        <div class="profile-content">
            <div class="profile-section">
                <h4>@L["Profile_PersonalInformation"]</h4>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">@L["Common_FirstName"]</label>
                        <input type="text" class="form-control" @bind="applicant.Name" disabled="@(!isEditing)" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">@L["Common_LastName"]</label>
                        <input type="text" class="form-control" @bind="applicant.Lastname" disabled="@(!isEditing)" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">@L["Common_Email"]</label>
                        <input type="email" class="form-control" @bind="applicant.ContactEmail" disabled="@(!isEditing)" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">@L["Common_Cellphone"]</label>
                        <input type="tel" class="form-control" @bind="applicant.Cellphone" disabled="@(!isEditing)" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">@L["Profile_CurrentJob"]</label>
                        <input type="text" class="form-control" @bind="applicant.CurrentJob" disabled="@(!isEditing)" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">@L["Common_LinkedInUrl"]</label>
                        <input type="url" class="form-control" @bind="applicant.LinkedInUrl" disabled="@(!isEditing)" />
                    </div>
                </div>

                @if (isEditing)
                {
                    <button class="btn btn-success" @onclick="SaveProfile">
                        <i class="bi bi-check"></i> @L["Common_SaveChanges"]
                    </button>
                }
            </div>

            <div class="profile-section">
                <div class="section-header">
                    <h4>@L["Nav_CvVersions"]</h4>
                    <button class="btn btn-sm btn-primary" @onclick="ShowUploadCVModal">
                        <i class="bi bi-upload"></i> @L["Profile_UploadCv"]
                    </button>
                </div>

                @if (applicant.CVVersions.Any())
                {
                    <div class="cv-list">
                        @foreach (var cv in applicant.CVVersions.OrderByDescending(c => c.UploadedDate))
                        {
                            <div class="cv-item">
                                <div class="cv-info">
                                    <strong>@cv.Name</strong>
                                    <small class="text-muted">@L["Cv_Uploaded", cv.UploadedDate.ShortDate()]</small>
                                    @if (cv.IsDefault)
                                    {
                                        <span class="badge bg-primary">@L["Cv_Default"]</span>
                                    }
                                </div>
                                <div class="cv-actions">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => DownloadCV(cv)">
                                        <i class="bi bi-download"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => SetDefaultCV(cv)">
                                        <i class="bi bi-star"></i> @L["Cv_SetDefault"]
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">@L["Profile_NoCvVersions"]</p>
                }
            </div>

            <div class="profile-section">
                <div class="section-header">
                    <h4>@L["Profile_References"]</h4>
                    <button class="btn btn-sm btn-primary" @onclick="ShowAddReferenceModal">
                        <i class="bi bi-plus"></i> @L["Profile_AddReference"]
                    </button>
                </div>

                @if (applicant.PastJobReferences.Any())
                {
                    <div class="references-list">
                        @foreach (var reference in applicant.PastJobReferences)
                        {
                            <div class="reference-card">
                                <div class="reference-header">
                                    <h5>@reference.JobTitle</h5>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteReference(reference.Id)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                                <p class="company-name">@reference.CompanyName</p>
                                <p class="date-range">
                                    @reference.StartDate.ShortDate() -
                                    @(reference.EndDate.HasValue ? reference.EndDate.Value.ShortDate() : L["Profile_Present"].Value)
                                </p>
                                <div class="contact-info">
                                    <p><strong>@L["Profile_ContactLabel"]</strong> @reference.ContactName</p>
                                    <p><i class="bi bi-envelope"></i> @reference.ContactEmail</p>
                                    @if (!string.IsNullOrEmpty(reference.ContactPhone))
                                    {
                                        <p><i class="bi bi-telephone"></i> @reference.ContactPhone</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">@L["Profile_NoReferences"]</p>
                }
            </div>
        </div>
    }
</div>

@if (showCVUploadModal)
{
    <div class="modal show" style="display: block; background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@L["Profile_UploadCv"]</h5>
                    <button type="button" class="btn-close" @onclick="() => showCVUploadModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@L["Profile_CvNameLabel"]</label>
                        <input type="text" class="form-control" @bind="newCVName" placeholder="@L["Profile_CvNamePlaceholder"]" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["Profile_FileLabel"]</label>
                        <InputFile class="form-control" OnChange="HandleCVUpload" accept=".pdf,.doc,.docx" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => showCVUploadModal = false">@L["Common_Cancel"]</button>
                    <button type="button" class="btn btn-primary" @onclick="UploadCV" disabled="@isUploading">
                        @if (isUploading)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        @L["Profile_UploadAction"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showReferenceModal)
{
    <div class="modal show" style="display: block; background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@L["Profile_AddReferenceTitle"]</h5>
                    <button type="button" class="btn-close" @onclick="() => showReferenceModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@L["Common_CompanyName"]</label>
                            <input type="text" class="form-control" @bind="newReference.CompanyName" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@L["Common_JobTitle"]</label>
                            <input type="text" class="form-control" @bind="newReference.JobTitle" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@L["Common_StartDate"]</label>
                            <input type="date" class="form-control" @bind="newReference.StartDate" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@L["Profile_EndDateLabel"]</label>
                            <input type="date" class="form-control" @bind="newReference.EndDate" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["Profile_ContactName"]</label>
                        <input type="text" class="form-control" @bind="newReference.ContactName" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@L["Profile_ContactEmail"]</label>
                            <input type="email" class="form-control" @bind="newReference.ContactEmail" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@L["Profile_ContactPhone"]</label>
                            <input type="tel" class="form-control" @bind="newReference.ContactPhone" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => showReferenceModal = false">@L["Common_Cancel"]</button>
                    <button type="button" class="btn btn-primary" @onclick="AddReference">@L["Profile_AddReference"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ApplicantDto applicant = new();
    private bool isLoading = true;
    private bool isEditing = false;
    private bool showCVUploadModal = false;
    private bool showReferenceModal = false;
    private bool isUploading = false;
    private string newCVName = "";
    private IBrowserFile? selectedFile;
    private JobReferenceDto newReference = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        isLoading = true;
        try
        {
            applicant = await ApplicantService.GetCurrentApplicantAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading profile: {ex.Message}");
            ToastService.ShowError(L["Profile_LoadFailed"]);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleEditMode()
    {
        isEditing = !isEditing;
    }

    private async Task SaveProfile()
    {
        try
        {
            await ApplicantService.UpdateProfileAsync(applicant);
            isEditing = false;
            ToastService.ShowSuccess(L["Profile_Saved"]);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving profile: {ex.Message}");
            ToastService.ShowError(L["Profile_SaveFailed"]);
        }
    }

    private void ShowUploadCVModal()
    {
        newCVName = "";
        selectedFile = null;
        showCVUploadModal = true;
    }

    private void HandleCVUpload(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        if (string.IsNullOrEmpty(newCVName))
        {
            newCVName = Path.GetFileNameWithoutExtension(selectedFile.Name);
        }
    }

    private async Task UploadCV()
    {
        if (selectedFile == null) return;
        
        isUploading = true;
        try
        {
            using var stream = selectedFile.OpenReadStream(maxAllowedSize: MaxUploadBytes);
            var cv = await ApplicantService.UploadCVAsync(
                newCVName, selectedFile.Name, selectedFile.ContentType, stream);
            applicant.CVVersions.Add(cv);
            showCVUploadModal = false;
            ToastService.ShowSuccess(L["Profile_CvUploaded"]);
        }
        catch (HttpRequestException ex)
        {
            // Server-side validation reads the file's bytes, so its message
            // says something the user can act on.
            Console.WriteLine($"Error uploading CV: {ex.Message}");
            ToastService.ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error uploading CV: {ex.Message}");
            ToastService.ShowError(L["Profile_CvUploadFailed"]);
        }
        finally
        {
            isUploading = false;
        }
    }

    /// <summary>Matches the server limit so oversized files fail fast, in the browser.</summary>
    private const long MaxUploadBytes = 5 * 1024 * 1024;

    private async Task DownloadCV(CVVersionDto cv)
    {
        if (!cv.HasFile)
        {
            ToastService.ShowError(L["Profile_CvNoFile"]);
            return;
        }

        try
        {
            // The stored document is private; this asks the API for a link that
            // works for a few minutes and then stops working.
            var link = await ApplicantService.GetCVDownloadLinkAsync(cv.Id);
            await JSRuntime.InvokeVoidAsync("open", link.Url, "_blank");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error downloading CV: {ex.Message}");
            ToastService.ShowError(L["Cv_OpenFailed"]);
        }
    }

    private async Task SetDefaultCV(CVVersionDto cv)
    {
        try
        {
            await CVVersionService.SetDefaultAsync(cv.Id);
            foreach (var c in applicant.CVVersions)
            {
                c.IsDefault = c.Id == cv.Id;
            }
            ToastService.ShowSuccess(L["Cv_DefaultUpdated"]);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error setting default CV: {ex.Message}");
            ToastService.ShowError(L["Cv_SetDefaultFailed"]);
        }
    }

    private void ShowAddReferenceModal()
    {
        newReference = new JobReferenceDto { Id = Guid.NewGuid().ToString() };
        showReferenceModal = true;
    }

    private async Task AddReference()
    {
        try
        {
            var added = await ApplicantService.AddReferenceAsync(newReference);
            applicant.PastJobReferences.Add(added);
            showReferenceModal = false;
            ToastService.ShowSuccess(L["Profile_ReferenceAdded"]);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding reference: {ex.Message}");
            ToastService.ShowError(L["Profile_ReferenceAddFailed"]);
        }
    }

    private async Task DeleteReference(string id)
    {
        try
        {
            await ApplicantService.DeleteReferenceAsync(id);
            applicant.PastJobReferences.RemoveAll(r => r.Id == id);
            ToastService.ShowSuccess(L["Profile_ReferenceDeleted"]);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting reference: {ex.Message}");
            ToastService.ShowError(L["Profile_ReferenceDeleteFailed"]);
        }
    }
}
