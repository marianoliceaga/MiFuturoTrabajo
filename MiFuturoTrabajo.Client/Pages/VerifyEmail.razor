@page "/verify-email"
@using MiFuturoTrabajo.Client.Services
@using Blazored.Toast.Services
@inject IAuthenticationService AuthService
@inject IToastService ToastService
@inject NavigationManager Navigation

<PageTitle>@L["Verify_PageTitle"]</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body text-center p-5">
                    @if (isVerifying)
                    {
                        <div class="spinner-border text-primary mb-3" role="status">
                            <span class="visually-hidden">@L["Verify_InProgressShort"]</span>
                        </div>
                        <h4 class="mb-3">@L["Verify_InProgress"]</h4>
                        <p class="text-muted">@L["Verify_PleaseWait"]</p>
                    }
                    else if (isSuccess)
                    {
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
                        <h4 class="mt-3 mb-3">@L["Verify_SuccessHeading"]</h4>
                        <p class="text-muted">@L["Verify_SuccessBody"]</p>
                        <a href="/login" class="btn btn-primary mt-3 w-100">@L["Verify_ProceedToLogin"]</a>
                    }
                    else
                    {
                        <i class="bi bi-x-circle-fill text-danger" style="font-size: 3rem;"></i>
                        <h4 class="mt-3 mb-3">@L["Verify_FailedHeading"]</h4>
                        <p class="text-muted">@errorMessage</p>
                        <a href="/login" class="btn btn-outline-primary mt-3 w-100">@L["Auth_BackToLogin"]</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    /// <summary>
    /// The link carries the address alongside the token so the API can find the
    /// account with a single-partition read instead of scanning every user.
    /// </summary>
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    private bool isVerifying = true;
    private bool isSuccess = false;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Assigned here rather than in the field initialiser: a field
        // initialiser runs before the injected localiser is available.
        errorMessage = L["Verify_LinkInvalid"];

        if (string.IsNullOrEmpty(Token) || string.IsNullOrEmpty(Email))
        {
            isVerifying = false;
            return;
        }

        try
        {
            isSuccess = await AuthService.VerifyEmailAsync(Email, Token);
            if (isSuccess)
            {
                ToastService.ShowSuccess(L["Verify_Success"]);
            }
            else
            {
                ToastService.ShowError(L["Verify_Failed"]);
            }
        }
        catch (Exception)
        {
            isSuccess = false;
            ToastService.ShowError(L["Verify_Error"]);
        }
        finally
        {
            isVerifying = false;
        }
    }
}
