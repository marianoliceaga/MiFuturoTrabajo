@page "/board"
@using MiFuturoTrabajo.Shared.Models
@using MiFuturoTrabajo.Client.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using Blazored.Toast.Services
@attribute [Authorize]
@inject IJobApplicationService JobApplicationService
@inject NavigationManager NavigationManager
@inject IToastService ToastService

<PageTitle>@L["PageTitle_Board"]</PageTitle>

<div class="kanban-container">
    <div class="header">
        <h2>@L["PageTitle_Board"]</h2>
        <button class="btn btn-primary" @onclick="CreateNewApplication">
            <i class="bi bi-plus-circle"></i> @L["Board_NewApplication"]
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading-spinner">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">@L["Common_Loading"]</span>
            </div>
        </div>
    }
    else
    {
        <div class="kanban-board">
            @foreach (var column in boardColumns)
            {
                <div class="kanban-column" @ondrop="@(() => HandleDrop(column.Status))"
                     @ondragover:preventDefault
                     @ondragenter="() => HandleDragEnter(column.Status)">
                    <div class="column-header">
                        <h4>@L.BoardColumn(column.Status)</h4>
                        <span class="badge bg-secondary">@column.Applications.Count</span>
                    </div>
                    <div class="column-body">
                        @foreach (var app in column.Applications)
                        {
                            <div class="kanban-card"
                                 draggable="true"
                                 @ondragstart="() => HandleDragStart(app)"
                                 @onclick="() => ViewApplication(app.Id)">
                                <div class="card-header-small">
                                    <strong>@app.JobTitle</strong>
                                </div>
                                <div class="card-body-small">
                                    <p class="company-name">@app.Company?.Name</p>
                                    <p class="location"><i class="bi bi-geo-alt"></i> @app.Location</p>
                                    @if (app.Salary > 0)
                                    {
                                        <p class="salary"><i class="bi bi-currency-dollar"></i> @app.Salary.ToString("N0")</p>
                                    }
                                    <div class="card-footer-small">
                                        <span class="badge bg-info">@L.Enum(app.Source)</span>
                                        @if (app.InterviewSteps.Any())
                                        {
                                            <span class="badge bg-warning">@L.Plural("Board_Step", app.InterviewSteps.Count)</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<BoardColumnDto> boardColumns = new();
    private bool isLoading = true;
    private JobApplicationDto? draggedApplication;
    private JobApplicationStatus? dragOverColumn;

    protected override async Task OnInitializedAsync()
    {
        await LoadBoardData();
    }

    private async Task LoadBoardData()
    {
        isLoading = true;
        try
        {
            boardColumns = await JobApplicationService.GetBoardDataAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading board: {ex.Message}");
            ToastService.ShowError(L["Board_LoadFailed"]);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void HandleDragStart(JobApplicationDto application)
    {
        draggedApplication = application;
    }

    private void HandleDragEnter(JobApplicationStatus status)
    {
        dragOverColumn = status;
    }

    private async Task HandleDrop(JobApplicationStatus newStatus)
    {
        if (draggedApplication != null && draggedApplication.Status != newStatus)
        {
            try
            {
                await JobApplicationService.UpdateStatusAsync(draggedApplication.Id, newStatus);
                await LoadBoardData();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error updating status: {ex.Message}");
                ToastService.ShowError(L["Board_MoveFailed"]);
            }
        }
        draggedApplication = null;
        dragOverColumn = null;
    }

    private void ViewApplication(string id)
    {
        NavigationManager.NavigateTo($"/applications/{id}");
    }

    private void CreateNewApplication()
    {
        NavigationManager.NavigateTo("/applications/new");
    }
}
