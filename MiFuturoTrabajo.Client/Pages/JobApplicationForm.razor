@page "/applications/new"
@page "/applications/{Id}"
@using MiFuturoTrabajo.Shared.Models
@using MiFuturoTrabajo.Client.Services
@using MiFuturoTrabajo.Client.Components
@using Microsoft.AspNetCore.Authorization
@using Blazored.Toast.Services
@attribute [Authorize]
@inject IJobApplicationService JobApplicationService
@inject ICompanyService CompanyService
@inject IRecruiterService RecruiterService
@inject IApplicantService ApplicantService
@inject NavigationManager NavigationManager
@inject IToastService ToastService

<div class="form-container">
    <div class="form-header">
        <h2>@(IsNew ? L["JobForm_NewHeading"] : L["JobForm_EditHeading"])</h2>
        <button class="btn btn-outline-secondary" @onclick="Cancel">
            <i class="bi bi-x"></i> @L["Common_Cancel"]
        </button>
    </div>

    <EditForm Model="@application" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-section">
            <h4>@L["JobForm_BasicInformation"]</h4>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">@L["JobForm_JobTitleLabel"]</label>
                    <InputText class="form-control" @bind-Value="application.JobTitle" />
                </div>
                
                <div class="col-md-6 mb-3">
                    <label class="form-label">@L["JobForm_CompanyLabel"]</label>
                    <div class="input-group">
                        <InputText class="form-control" @bind-Value="companySearch"
                                   @oninput="SearchCompanies" placeholder="@L["JobForm_CompanySearchPlaceholder"]" />
                        <button class="btn btn-outline-secondary" type="button" @onclick="OpenCompanyModal" title="@L["JobForm_ManageCompany"]">
                            <i class="bi bi-plus"></i>
                        </button>
                    </div>
                    @if (companySuggestions.Any())
                    {
                        <ul class="suggestions-list">
                            @foreach (var company in companySuggestions)
                            {
                                <li @onclick="() => SelectCompany(company)">
                                    <div class="suggestion-content">
                                        <span class="suggestion-name">@company.Name</span>
                                        <button class="btn btn-sm btn-link suggestion-edit" type="button"
                                                @onclick:stopPropagation="true"
                                                @onclick="() => EditCompanyFromSuggestion(company)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    @if (!string.IsNullOrEmpty(application.Company?.Name))
                    {
                        <div class="selected-company">
                            <i class="bi bi-building"></i> @application.Company.Name
                            <button class="btn btn-sm btn-link" type="button" @onclick="() => EditSelectedCompany()">
                                <i class="bi bi-pencil"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">@L["Applications_ColLocation"]</label>
                    <InputText class="form-control" @bind-Value="application.Location" />
                </div>
                
                <div class="col-md-6 mb-3">
                    <label class="form-label">@L["JobForm_ExpectedSalary"]</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-currency-dollar"></i></span>
                        <InputNumber class="form-control" @bind-Value="application.Salary" placeholder="0" />
                    </div>
                    <div class="form-text">@L["JobForm_ExpectedSalaryHint"]</div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">@L["JobForm_SourceLabel"]</label>
                    <InputSelect class="form-select" @bind-Value="application.Source">
                        @foreach (JobSource source in Enum.GetValues(typeof(JobSource)))
                        {
                            <option value="@source">@L.Enum(source)</option>
                        }
                    </InputSelect>
                </div>
                
                <div class="col-md-8 mb-3">
                    <label class="form-label">@L["JobForm_UrlLabel"]</label>
                    <InputText class="form-control" @bind-Value="application.URL" type="url" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">@L["JobForm_DescriptionLabel"]</label>
                <InputTextArea class="form-control" @bind-Value="application.JobDescription" rows="4" />
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="application.IsDirect" id="isDirect" />
                        <label class="form-check-label" for="isDirect">@L["JobForm_DirectApplication"]</label>
                    </div>
                </div>
                
                <div class="col-md-4 mb-3">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="application.IsConsultancy" id="isConsultancy" />
                        <label class="form-check-label" for="isConsultancy">@L["JobForm_ThroughConsultancy"]</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-section">
            <h4>@L["JobForm_CvSection"]</h4>
            <div class="mb-3">
                <label class="form-label">@L["JobForm_SelectCvLabel"]</label>
                <select class="form-select" @bind="application.CVUsedId">
                    <option value="">@L["JobForm_SelectCvOption"]</option>
                    @foreach (var cv in cvVersions)
                    {
                        <option value="@cv.Id">@cv.Name (@cv.UploadedDate.ShortDate())</option>
                    }
                </select>
            </div>
        </div>

        <div class="form-section">
            <h4>@L["JobForm_RecruiterSection"]</h4>
            <div class="mb-3">
                <label class="form-label">@L["JobSource_Recruiter"]</label>
                <div class="input-group">
                    <select class="form-select" @bind="application.MainRecruiterContactId">
                        <option value="">@L["JobForm_SelectRecruiterOption"]</option>
                        @foreach (var recruiter in recruiters)
                        {
                            <option value="@recruiter.Id">@recruiter.Name @recruiter.Lastname</option>
                        }
                    </select>
                    <button class="btn btn-outline-secondary" type="button" @onclick="AddNewRecruiter">
                        <i class="bi bi-plus"></i> @L["JobForm_AddNew"]
                    </button>
                </div>
            </div>
        </div>

        <div class="form-section">
            <h4>@L["JobForm_InterviewSection"]</h4>
            <button type="button" class="btn btn-sm btn-outline-primary mb-2" @onclick="AddInterviewStep">
                <i class="bi bi-plus"></i> @L["JobForm_AddStep"]
            </button>
            
            @if (application.InterviewSteps.Any())
            {
                <div class="interview-steps">
                    @foreach (var step in application.InterviewSteps.OrderBy(s => s.StepOrder))
                    {
                        <div class="interview-step-card">
                            <div class="step-header">
                                <input type="text" class="form-control form-control-sm" 
                                       @bind="step.StepName" placeholder="@L["JobForm_StepNamePlaceholder"]" />
                                <button type="button" class="btn btn-sm btn-outline-danger" 
                                        @onclick="() => RemoveInterviewStep(step)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                            <div class="step-body">
                                <input type="datetime-local" class="form-control form-control-sm" 
                                       @bind="step.ScheduledDate" />
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" 
                                           @bind="step.IsCompleted" id="completed-@step.Id" />
                                    <label class="form-check-label" for="completed-@step.Id">@L["JobForm_StepCompleted"]</label>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="form-section">
            <h4>@L["JobForm_AdditionalInformation"]</h4>
            
            <div class="mb-3">
                <label class="form-label">@L["JobForm_DeadlineLabel"]</label>
                <InputDate class="form-control" @bind-Value="application.DeadLine" />
            </div>

            <div class="mb-3">
                <label class="form-label">@L["Applications_ColStatus"]</label>
                <InputSelect class="form-select" @bind-Value="application.Status">
                    @foreach (JobApplicationStatus status in Enum.GetValues(typeof(JobApplicationStatus)))
                    {
                        <option value="@status">@L.Enum(status)</option>
                    }
                </InputSelect>
            </div>

            <div class="mb-3">
                <label class="form-label">@L["Companies_LabelsLabel"]</label>
                <input type="text" class="form-control" @bind="labelsString" 
                       placeholder="@L["JobForm_LabelsPlaceholder"]" />
            </div>
        </div>

        @if (application.Status == JobApplicationStatus.Offer || application.Status == JobApplicationStatus.Completed)
        {
            <div class="form-section offer-section">
                <div class="offer-banner">
                    <i class="bi bi-trophy-fill"></i>
                    <div>
                        <h5>🎉 @L["JobForm_OfferBannerHeading"]</h5>
                        <p>@L["JobForm_OfferBannerBody"]</p>
                    </div>
                </div>

                <h4><i class="bi bi-file-earmark-text"></i> @L["JobForm_OfferSection"]</h4>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">@L["JobForm_OfferedSalary"]</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-currency-dollar"></i></span>
                            <InputNumber class="form-control" @bind-Value="application.Salary" placeholder="0" />
                        </div>
                        <div class="form-text">@L["JobForm_OfferedSalaryHint"]</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">@L["JobForm_OfferDate"]</label>
                        <InputDate class="form-control" @bind-Value="application.DateApplied" />
                        <div class="form-text">@L["JobForm_OfferDateHint"]</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">@L["JobForm_OfferNotes"]</label>
                    <InputTextArea class="form-control" @bind-Value="application.JobOffer" rows="5"
                                   placeholder="@L["JobForm_OfferNotesPlaceholder"]" />
                    <div class="form-text">@L["JobForm_OfferNotesHint"]</div>
                </div>
            </div>
        }

        <div class="form-actions">
            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    <span>@L["Common_Saving"]</span>
                }
                else
                {
                    <i class="bi bi-save"></i>
                    <span>@L["JobForm_Save"]</span>
                }
            </button>
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">
                @L["Common_Cancel"]
            </button>
        </div>
    </EditForm>
</div>

<CompanyModal IsVisible="showCompanyModal"
              Company="editingCompany"
              InitialName="@companySearch"
              OnCompanySaved="HandleCompanySaved"
              OnCancel="CloseCompanyModal" />

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private JobApplicationDto application = new();
    private List<CompanyDto> companySuggestions = new();
    private List<RecruiterDto> recruiters = new();
    private List<CVVersionDto> cvVersions = new();
    private string companySearch = "";
    private string labelsString = "";
    private bool isSaving = false;
    private bool showCompanyModal = false;
    private CompanyDto? editingCompany = null;
    private bool IsNew => string.IsNullOrEmpty(Id);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        
        if (!IsNew)
        {
            application = await JobApplicationService.GetByIdAsync(Id);
            companySearch = application.Company?.Name ?? "";
            labelsString = string.Join(", ", application.Labels);
        }
        else
        {
            application.DateApplied = DateTime.Now;
            application.DeadLine = DateTime.Now.AddDays(7);
        }
    }

    private async Task LoadData()
    {
        try
        {
            recruiters = await RecruiterService.GetAllAsync();
            var currentApplicant = await ApplicantService.GetCurrentApplicantAsync();
            cvVersions = currentApplicant?.CVVersions ?? new List<CVVersionDto>();
            application.ApplicantId = currentApplicant?.Id ?? "";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
            ToastService.ShowError(L["JobForm_LoadFailed"]);
        }
    }

    private async Task SearchCompanies(ChangeEventArgs e)
    {
        companySearch = e.Value?.ToString() ?? "";
        if (companySearch.Length >= 2)
        {
            companySuggestions = await CompanyService.SearchAsync(companySearch);
        }
        else
        {
            companySuggestions.Clear();
        }
    }

    private void SelectCompany(CompanyDto company)
    {
        application.Company = company;
        companySearch = company.Name;
        companySuggestions.Clear();
    }

    private void OpenCompanyModal()
    {
        editingCompany = null; // Create new company
        showCompanyModal = true;
    }

    private void EditCompanyFromSuggestion(CompanyDto company)
    {
        editingCompany = company;
        showCompanyModal = true;
    }

    private void EditSelectedCompany()
    {
        editingCompany = application.Company;
        showCompanyModal = true;
    }

    private void CloseCompanyModal()
    {
        showCompanyModal = false;
        editingCompany = null;
    }

    private async Task HandleCompanySaved(CompanyDto savedCompany)
    {
        // Update the application with the saved company
        application.Company = savedCompany;
        companySearch = savedCompany.Name;
        companySuggestions.Clear();

        // Refresh suggestions to show the updated/new company
        if (companySearch.Length >= 2)
        {
            companySuggestions = await CompanyService.SearchAsync(companySearch);
        }
    }

    private void AddNewRecruiter()
    {
        NavigationManager.NavigateTo("/recruiters/new", true);
    }

    private void AddInterviewStep()
    {
        var maxOrder = application.InterviewSteps.Any() 
            ? application.InterviewSteps.Max(s => s.StepOrder) 
            : 0;
        
        application.InterviewSteps.Add(new InterviewStepDto
        {
            Id = Guid.NewGuid().ToString(),
            StepOrder = maxOrder + 1,
            StepName = L["JobForm_DefaultStepName", maxOrder + 1]
        });
    }

    private void RemoveInterviewStep(InterviewStepDto step)
    {
        application.InterviewSteps.Remove(step);
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        try
        {
            application.Labels = labelsString
                .Split(',')
                .Select(l => l.Trim())
                .Where(l => !string.IsNullOrEmpty(l))
                .ToList();

            if (IsNew)
            {
                await JobApplicationService.CreateAsync(application);
            }
            else
            {
                await JobApplicationService.UpdateAsync(Id, application);
            }

            ToastService.ShowSuccess(IsNew ? L["JobForm_Created"] : L["JobForm_Updated"]);
            NavigationManager.NavigateTo("/board");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving application: {ex.Message}");
            ToastService.ShowError(L["JobForm_SaveFailed"]);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/board");
    }
}
