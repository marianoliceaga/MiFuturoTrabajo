@page "/tasks/new"
@page "/tasks/{Id}"
@using MiFuturoTrabajo.Shared.Models
@using MiFuturoTrabajo.Client.Services
@using Microsoft.AspNetCore.Authorization
@using Blazored.Toast.Services
@attribute [Authorize]
@inject IApplicantTaskService TaskService
@inject IJobApplicationService JobApplicationService
@inject IApplicantService ApplicantService
@inject NavigationManager NavigationManager
@inject IToastService ToastService

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h3 class="card-title mb-0">@(IsNew ? L["TaskForm_NewHeading"] : L["TaskForm_EditHeading"])</h3>
                </div>
                <div class="card-body">
                    <EditForm Model="@task" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">@L["TaskForm_TitleLabel"]</label>
                            <InputText class="form-control" @bind-Value="task.Title" placeholder="@L["TaskForm_TitlePlaceholder"]" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">@L["Tasks_ColType"]</label>
                                <InputSelect class="form-select" @bind-Value="task.Type">
                                    @foreach (TaskType type in Enum.GetValues(typeof(TaskType)))
                                    {
                                        <option value="@type">@L.Enum(type)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">@L["Applications_ColDeadline"]</label>
                                <InputDate class="form-control" @bind-Value="task.Deadline" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@L["TaskForm_RelatedApplication"]</label>
                            <InputSelect class="form-select" @bind-Value="task.JobApplicationId">
                                <option value="">@L["TaskForm_NoApplication"]</option>
                                @foreach (var app in applications)
                                {
                                    <option value="@app.Id">@app.JobTitle - @(app.Company?.Name ?? L["TaskForm_UnknownCompany"].Value)</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@L["TaskForm_NotesLabel"]</label>
                            <InputTextArea class="form-control" @bind-Value="task.Note" rows="4" />
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">@L["Common_Cancel"]</button>
                            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span>@L["Common_Saving"]</span>
                                }
                                else
                                {
                                    <i class="bi bi-save"></i>
                                    <span>@L["Common_Save"]</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private ApplicantTaskDto task = new();
    private List<JobApplicationDto> applications = new();
    private bool IsNew => string.IsNullOrEmpty(Id);
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var appsTask = JobApplicationService.GetAllAsync();
            
            if (!IsNew)
            {
                var taskTask = TaskService.GetByIdAsync(Id);
                await Task.WhenAll(appsTask, taskTask);
                task = taskTask.Result;
                applications = appsTask.Result;
            }
            else
            {
                applications = await appsTask;
                // Set defaults
                var applicant = await ApplicantService.GetCurrentApplicantAsync();
                task.ApplicantId = applicant?.Id ?? string.Empty;
                task.Deadline = DateTime.Today;
                task.StartDate = DateTime.Today;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
            ToastService.ShowError(L["TaskForm_LoadFailed"]);
        }
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        try
        {
            if (IsNew)
            {
                await TaskService.CreateAsync(task);
            }
            else
            {
                await TaskService.UpdateAsync(Id, task);
            }
            ToastService.ShowSuccess(IsNew ? L["TaskForm_Created"] : L["TaskForm_Updated"]);
            NavigationManager.NavigateTo("/tasks");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving task: {ex.Message}");
            ToastService.ShowError(L["TaskForm_SaveFailed"]);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/tasks");
    }
}
