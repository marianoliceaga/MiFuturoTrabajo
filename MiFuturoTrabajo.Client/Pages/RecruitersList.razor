@page "/recruiters"
@using MiFuturoTrabajo.Shared.Models
@using MiFuturoTrabajo.Client.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using Blazored.Toast.Services
@attribute [Authorize]
@inject IRecruiterService RecruiterService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IToastService ToastService

<div class="recruiters-container">
    <div class="recruiters-header">
        <h2>@L["Nav_Recruiters"]</h2>
        <button class="btn btn-primary" @onclick="ShowAddRecruiterModal">
            <i class="bi bi-plus"></i> @L["Recruiters_Add"]
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading">@L["Common_Loading"]</div>
    }
    else if (recruiters.Any())
    {
        <div class="recruiters-grid">
            @foreach (var recruiter in recruiters)
            {
                <div class="recruiter-card">
                    <div class="recruiter-header">
                        <div class="recruiter-name">
                            <h5>@recruiter.Name @recruiter.Lastname</h5>
                            @if (recruiter.IsFromConsultancy)
                            {
                                <span class="badge bg-info">@L["Recruiters_Consultancy"]</span>
                            }
                        </div>
                        <div class="recruiter-actions">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEditRecruiterModal(recruiter)">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRecruiter(recruiter.Id)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(recruiter.CompanyName))
                    {
                        <p class="company-name">
                            <i class="bi bi-building"></i> @recruiter.CompanyName
                        </p>
                    }

                    <div class="contact-info">
                        @if (!string.IsNullOrEmpty(recruiter.ContactEmail))
                        {
                            <p>
                                <i class="bi bi-envelope"></i>
                                <a href="mailto:@recruiter.ContactEmail">@recruiter.ContactEmail</a>
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(recruiter.Cellphone))
                        {
                            <p>
                                <i class="bi bi-phone"></i>
                                <a href="tel:@recruiter.Cellphone">@recruiter.Cellphone</a>
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(recruiter.Landline))
                        {
                            <p>
                                <i class="bi bi-telephone"></i>
                                <a href="tel:@recruiter.Landline">@recruiter.Landline</a>
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(recruiter.LinkedInUrl))
                        {
                            <p>
                                <i class="bi bi-linkedin"></i>
                                <a href="@recruiter.LinkedInUrl" target="_blank">@L["Recruiters_LinkedInProfile"]</a>
                            </p>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-people"></i>
            <h4>@L["Recruiters_EmptyHeading"]</h4>
            <p>@L["Recruiters_EmptyBody"]</p>
            <button class="btn btn-primary" @onclick="ShowAddRecruiterModal">
                <i class="bi bi-plus"></i> @L["Recruiters_AddFirst"]
            </button>
        </div>
    }
</div>

@if (showRecruiterModal)
{
    <div class="modal show" style="display: block; background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditMode ? L["Recruiters_EditTitle"] : L["Recruiters_AddTitle"])</h5>
                    <button type="button" class="btn-close" @onclick="CloseRecruiterModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@L["Recruiters_FirstNameLabel"]</label>
                            <input type="text" class="form-control" @bind="currentRecruiter.Name" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@L["Recruiters_LastNameLabel"]</label>
                            <input type="text" class="form-control" @bind="currentRecruiter.Lastname" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@L["Common_Email"]</label>
                            <input type="email" class="form-control" @bind="currentRecruiter.ContactEmail" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@L["Common_Cellphone"]</label>
                            <input type="tel" class="form-control" @bind="currentRecruiter.Cellphone" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@L["Common_Landline"]</label>
                            <input type="tel" class="form-control" @bind="currentRecruiter.Landline" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@L["Common_LinkedInUrl"]</label>
                            <input type="url" class="form-control" @bind="currentRecruiter.LinkedInUrl" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@L["Common_CompanyName"]</label>
                            <input type="text" class="form-control" @bind="currentRecruiter.CompanyName" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-check mt-4">
                                <input class="form-check-input" type="checkbox" id="isConsultancy" @bind="currentRecruiter.IsFromConsultancy" />
                                <label class="form-check-label" for="isConsultancy">
                                    @L["Recruiters_FromConsultancy"]
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseRecruiterModal">@L["Common_Cancel"]</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveRecruiter" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        @(isEditMode ? L["Recruiters_UpdateAction"] : L["Recruiters_AddAction"])
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<RecruiterDto> recruiters = new();
    private bool isLoading = true;
    private bool showRecruiterModal = false;
    private bool isEditMode = false;
    private bool isSaving = false;
    private RecruiterDto currentRecruiter = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadRecruiters();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Force re-render when modal visibility changes
        base.OnAfterRender(firstRender);
    }

    private async Task LoadRecruiters()
    {
        isLoading = true;
        try
        {
            recruiters = await RecruiterService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading recruiters: {ex.Message}");
            ToastService.ShowError(L["Recruiters_LoadFailed"]);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAddRecruiterModal()
    {
        currentRecruiter = new RecruiterDto
        {
            Id = Guid.NewGuid().ToString(),
            Name = "",
            Lastname = "",
            ContactEmail = "",
            Cellphone = "",
            Landline = "",
            LinkedInUrl = "",
            CompanyName = "",
            IsFromConsultancy = false
        };
        isEditMode = false;
        showRecruiterModal = true;
        StateHasChanged(); // Force UI update
    }

    private void ShowEditRecruiterModal(RecruiterDto recruiter)
    {
        currentRecruiter = new RecruiterDto
        {
            Id = recruiter.Id,
            Name = recruiter.Name ?? "",
            Lastname = recruiter.Lastname ?? "",
            ContactEmail = recruiter.ContactEmail ?? "",
            Cellphone = recruiter.Cellphone ?? "",
            Landline = recruiter.Landline ?? "",
            LinkedInUrl = recruiter.LinkedInUrl ?? "",
            IsFromConsultancy = recruiter.IsFromConsultancy,
            CompanyName = recruiter.CompanyName ?? ""
        };
        isEditMode = true;
        showRecruiterModal = true;
        StateHasChanged(); // Force UI update
    }

    private void CloseRecruiterModal()
    {
        showRecruiterModal = false;
        currentRecruiter = new RecruiterDto
        {
            Id = "",
            Name = "",
            Lastname = "",
            ContactEmail = "",
            Cellphone = "",
            Landline = "",
            LinkedInUrl = "",
            CompanyName = "",
            IsFromConsultancy = false
        };
        StateHasChanged(); // Force UI update
    }

    private async Task SaveRecruiter()
    {
        if (string.IsNullOrWhiteSpace(currentRecruiter.Name) || string.IsNullOrWhiteSpace(currentRecruiter.Lastname))
        {
            return;
        }

        isSaving = true;
        StateHasChanged(); // Show saving state

        try
        {
            if (isEditMode)
            {
                var updated = await RecruiterService.UpdateAsync(currentRecruiter.Id, currentRecruiter);
                var index = recruiters.FindIndex(r => r.Id == currentRecruiter.Id);
                if (index >= 0)
                {
                    recruiters[index] = updated;
                }
            }
            else
            {
                var created = await RecruiterService.CreateAsync(currentRecruiter);
                recruiters.Add(created);
            }
            CloseRecruiterModal();
            StateHasChanged(); // Update UI after save
            ToastService.ShowSuccess(isEditMode ? L["Recruiters_Updated"] : L["Recruiters_Added"]);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving recruiter: {ex.Message}");
            ToastService.ShowError(L["Recruiters_SaveFailed"]);
        }
        finally
        {
            isSaving = false;
            StateHasChanged(); // Ensure UI updates
        }
    }

    private async Task DeleteRecruiter(string id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", L["Recruiters_ConfirmDelete"].Value))
        {
            return;
        }

        try
        {
            await RecruiterService.DeleteAsync(id);
            recruiters.RemoveAll(r => r.Id == id);
            ToastService.ShowSuccess(L["Recruiters_Deleted"]);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting recruiter: {ex.Message}");
            ToastService.ShowError(L["Recruiters_DeleteFailed"]);
        }
    }
}
