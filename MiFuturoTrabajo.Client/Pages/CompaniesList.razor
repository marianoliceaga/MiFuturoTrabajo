@page "/companies"
@using MiFuturoTrabajo.Shared.Models
@using MiFuturoTrabajo.Client.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using Blazored.Toast.Services
@attribute [Authorize]
@inject ICompanyService CompanyService
@inject IJSRuntime JSRuntime
@inject IToastService ToastService

<div class="companies-container">
    <div class="companies-header">
        <h2>@L["Nav_Companies"]</h2>
        <button class="btn btn-primary" @onclick="ShowAddCompanyModal">
            <i class="bi bi-plus"></i> @L["Companies_Add"]
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading">@L["Common_Loading"]</div>
    }
    else if (companies.Any())
    {
        <div class="companies-grid">
            @foreach (var company in companies)
            {
                <div class="company-card">
                    <div class="company-header">
                        <div class="company-name-section">
                            <h5>@company.Name</h5>
                            @if (company.Labels.Any())
                            {
                                <div class="labels">
                                    @foreach (var label in company.Labels)
                                    {
                                        <span class="badge bg-secondary">@label</span>
                                    }
                                </div>
                            }
                        </div>
                        <div class="company-actions">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEditCompanyModal(company)">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCompany(company.Id)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(company.Description))
                    {
                        <p class="company-description">@company.Description</p>
                    }

                    <div class="company-info">
                        @if (!string.IsNullOrEmpty(company.Website))
                        {
                            <p>
                                <i class="bi bi-globe"></i>
                                <a href="@company.Website" target="_blank">@company.Website</a>
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(company.Telephone))
                        {
                            <p>
                                <i class="bi bi-telephone"></i>
                                <a href="tel:@company.Telephone">@company.Telephone</a>
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(company.Address))
                        {
                            <p>
                                <i class="bi bi-geo-alt"></i>
                                @company.Address
                                @if (!string.IsNullOrEmpty(company.Country))
                                {
                                    <span>, @company.Country</span>
                                }
                            </p>
                        }
                        else if (!string.IsNullOrEmpty(company.Country))
                        {
                            <p>
                                <i class="bi bi-geo-alt"></i>
                                @company.Country
                            </p>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-building"></i>
            <h4>@L["Companies_EmptyHeading"]</h4>
            <p>@L["Companies_EmptyBody"]</p>
            <button class="btn btn-primary" @onclick="ShowAddCompanyModal">
                <i class="bi bi-plus"></i> @L["Companies_AddFirst"]
            </button>
        </div>
    }
</div>

@if (showCompanyModal)
{
    <div class="modal show" style="display: block; background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditMode ? L["Companies_EditTitle"] : L["Companies_AddTitle"])</h5>
                    <button type="button" class="btn-close" @onclick="CloseCompanyModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@L["Companies_NameLabel"]</label>
                        <input type="text" class="form-control" @bind="currentCompany.Name" placeholder="@L["Companies_NamePlaceholder"]" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["Common_Description"]</label>
                        <textarea class="form-control" rows="3" @bind="currentCompany.Description" placeholder="@L["Companies_DescriptionPlaceholder"]"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@L["Common_Website"]</label>
                            <input type="url" class="form-control" @bind="currentCompany.Website" placeholder="https://..." />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@L["Common_Telephone"]</label>
                            <input type="tel" class="form-control" @bind="currentCompany.Telephone" placeholder="@L["Companies_TelephonePlaceholder"]" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label class="form-label">@L["Common_Address"]</label>
                            <input type="text" class="form-control" @bind="currentCompany.Address" placeholder="@L["Companies_AddressPlaceholder"]" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">@L["Common_Country"]</label>
                            <input type="text" class="form-control" @bind="currentCompany.Country" placeholder="@L["Common_Country"]" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["Companies_LabelsLabel"]</label>
                        <input type="text" class="form-control" @bind="labelsInput" placeholder="@L["Companies_LabelsPlaceholder"]" />
                        <small class="form-text text-muted">@L["Companies_LabelsHint"]</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseCompanyModal">@L["Common_Cancel"]</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveCompany" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        @(isEditMode ? L["Companies_UpdateAction"] : L["Companies_AddAction"])
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CompanyDto> companies = new();
    private bool isLoading = true;
    private bool showCompanyModal = false;
    private bool isEditMode = false;
    private bool isSaving = false;
    private CompanyDto currentCompany = new();
    private string labelsInput = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadCompanies();
    }

    private async Task LoadCompanies()
    {
        isLoading = true;
        try
        {
            companies = await CompanyService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading companies: {ex.Message}");
            ToastService.ShowError(L["Companies_LoadFailed"]);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAddCompanyModal()
    {
        currentCompany = new CompanyDto { Id = Guid.NewGuid().ToString() };
        labelsInput = "";
        isEditMode = false;
        showCompanyModal = true;
    }

    private void ShowEditCompanyModal(CompanyDto company)
    {
        currentCompany = new CompanyDto
        {
            Id = company.Id,
            Name = company.Name,
            Description = company.Description,
            Website = company.Website,
            Telephone = company.Telephone,
            Address = company.Address,
            Country = company.Country,
            Labels = new List<string>(company.Labels)
        };
        labelsInput = string.Join(", ", company.Labels);
        isEditMode = true;
        showCompanyModal = true;
    }

    private void CloseCompanyModal()
    {
        showCompanyModal = false;
        currentCompany = new();
        labelsInput = "";
    }

    private async Task SaveCompany()
    {
        if (string.IsNullOrWhiteSpace(currentCompany.Name))
        {
            return;
        }

        // Parse labels from comma-separated input
        currentCompany.Labels = labelsInput
            .Split(',')
            .Select(l => l.Trim())
            .Where(l => !string.IsNullOrWhiteSpace(l))
            .ToList();

        isSaving = true;
        try
        {
            if (isEditMode)
            {
                var updated = await CompanyService.UpdateAsync(currentCompany.Id, currentCompany);
                var index = companies.FindIndex(c => c.Id == currentCompany.Id);
                if (index >= 0)
                {
                    companies[index] = updated;
                }
            }
            else
            {
                var created = await CompanyService.CreateAsync(currentCompany);
                companies.Add(created);
            }
            CloseCompanyModal();
            ToastService.ShowSuccess(isEditMode ? L["Companies_Updated"] : L["Companies_Added"]);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving company: {ex.Message}");
            ToastService.ShowError(L["Companies_SaveFailed"]);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteCompany(string id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", L["Companies_ConfirmDelete"].Value))
        {
            return;
        }

        try
        {
            await CompanyService.DeleteAsync(id);
            companies.RemoveAll(c => c.Id == id);
            ToastService.ShowSuccess(L["Companies_Deleted"]);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting company: {ex.Message}");
            ToastService.ShowError(L["Companies_DeleteFailed"]);
        }
    }
}
