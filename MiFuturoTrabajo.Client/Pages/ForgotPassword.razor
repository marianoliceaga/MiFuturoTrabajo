@page "/forgot-password"
@inject IAuthenticationService AuthService
@inject Blazored.Toast.Services.IToastService ToastService

<PageTitle>@L["Forgot_PageTitle"]</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h2 class="card-title text-center mb-4">@L["Forgot_Heading"]</h2>

                    @if (emailSent)
                    {
                        <div class="alert alert-success" role="alert">
                            <h5 class="alert-heading">@L["Forgot_SentHeading"]</h5>
                            <p>@L["Forgot_SentBody"]</p>
                            <hr />
                            <p class="mb-0">@L["Forgot_NotReceived"] <a href="#" @onclick="() => emailSent = false" @onclick:preventDefault>@L["Forgot_TryAgain"]</a></p>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-4">@L["Forgot_Intro"]</p>

                        <EditForm Model="@email" OnValidSubmit="@HandleForgotPassword">
                            <div class="mb-3">
                                <label for="email" class="form-label">@L["Common_Email"]</label>
                                <input id="email" type="email" class="form-control" @bind="email" placeholder="@L["Common_EmailPlaceholder"]" required />
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>@L["Forgot_Sending"]</span>
                                    }
                                    else
                                    {
                                        <span>@L["Forgot_Send"]</span>
                                    }
                                </button>
                            </div>
                        </EditForm>

                        <hr class="my-4" />

                        <div class="text-center">
                            <p class="mb-0">
                                <a href="/login" class="text-decoration-none">@L["Auth_BackToLogin"]</a>
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = string.Empty;
    private bool emailSent = false;
    private bool isLoading = false;

    private async Task HandleForgotPassword()
    {
        isLoading = true;

        try
        {
            var result = await AuthService.ForgotPasswordAsync(email);

            // Always show success to prevent email enumeration
            emailSent = true;

            if (result)
            {
                ToastService.ShowInfo(L["Forgot_Sent"]);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Forgot password error: {ex.Message}");
            emailSent = true; // Still show success to user
        }
        finally
        {
            isLoading = false;
        }
    }
}
