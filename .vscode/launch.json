{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Blazor WebAssembly",
            "type": "chrome",
            "request": "launch",
            "url": "https://localhost:5011",
            "webRoot": "${workspaceFolder}/Letmework4U.Client",
            "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}"
        },
        {
            "name": "Launch API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/Letmework4U.Api/bin/Debug/net8.0/Letmework4U.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Letmework4U.Api",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://localhost:7071;http://localhost:7070"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "console": "internalConsole",
            "justMyCode": true
        }
    ],
    "compounds": [
        {
            "name": "Launch Blazor WebAssembly + API",
            "configurations": [
                "Launch API",
                "Launch Blazor WebAssembly"
            ],
            "stopAll": true
        }
    ]
}